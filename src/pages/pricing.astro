---
import BaseLayout from "../layouts/BaseLayout.astro";
import PencilUnderline from "../components/PencilUnderline.astro";
import Faq from "../components/Faq.astro";
import { faqs } from "../lib/faqs";

// Real values, reused from Footer.astro / Contact.astro / Hero.astro.
const bookingUrl =
	"https://www.fresha.com/en-GB/a/lafeli-beauty-willaston-nantwich-70-colleys-lane-hq1yvezc/booking?menu=true&pId=3085259";
const whatsappUrl = "https://wa.me/447769379946";
const phone = "+447769379946";
const address = "70 Colleys Lane, Willaston, Nantwich CW5 6NT";
const instagramUrl = "https://www.instagram.com/lili_lafeli/";
const facebookUrl = "https://www.facebook.com/p/Lilly-Massage-Therapist-100089978122676/";

// Treatment data. Images reused from WhatWeDo.astro (local only, no remote
// images). Prices/durations are not published anywhere in the codebase, so
// every price/duration field is a clearly labelled placeholder, see the
// TODO comments beside each one and in the final report.
interface Treatment {
	slug: string;
	category: "massage" | "waxing" | "nails" | "brows" | "bundles";
	index: string;
	name: string;
	image: string;
	imagePosition: string;
	alt: string;
	description: string;
	goodFor: string[];
	priceLabel: string;
	durationLabel: string;
	// Original price when discounted, plus small badges (all from Fresha).
	wasPrice?: string;
	badges?: string[];
	// Individual services with their own duration/price, as listed on Fresha.
	menu?: { name: string; duration: string; price: string; note?: string }[];
	// "Good to know" lines shown in a small panel.
	notes?: string[];
	expect: string[];
	aftercare: string[];
	// TODO: replace with a per-treatment Fresha deep link once available.
	bookingUrl: string;
}

const treatments: Treatment[] = [
	{
		slug: "lymphatic-drainage-massage",
		category: "massage",
		index: "01.",
		name: "Brazilian Lymphatic Drainage",
		image: "/images/gallery/drainage/1.jpg",
		imagePosition: "center",
		alt: "Lymphatic drainage massage treatment at Lafeli Beauty in Willaston",
		description:
			"Revitalise your well-being with a soothing massage that promotes natural detoxification. This nurturing treatment stimulates lymphatic flow, helping to reduce swelling and enhance relaxation, making it a perfect choice for anyone looking to unwind and rejuvenate their body.",
		goodFor: ["Puffiness and fluid retention", "Heavy or tired legs", "Post-travel recovery"],
		priceLabel: "£70",
		durationLabel: "1 hour",
		expect: [
			"A short chat about the areas you would like me to focus on.",
			"Light, rhythmic strokes following the direction of lymph flow.",
			"A calm, quiet room; most clients drift off during this one.",
			"A few minutes to sit up slowly and rehydrate before you leave.",
		],
		aftercare: [
			"Drink plenty of water over the following 24 hours.",
			"Avoid alcohol and very salty food on the day of your treatment.",
			"Gentle movement, such as a walk, helps keep things moving afterwards.",
			"Some light-headedness or a trip to the bathroom soon after is normal.",
		],
		bookingUrl,
	},
	{
		slug: "relaxing-massage",
		category: "massage",
		index: "02.",
		name: "Aromatherapy Massage / Relaxation",
		image: "/images/gallery/massage/1.jpg",
		imagePosition: "center 72%",
		alt: "Relaxing full-body massage treatment at Lafeli Beauty in Willaston",
		description:
			"Indulge in a soothing experience that blends touch and fragrance for ultimate relaxation. This massage works to alleviate tension, promote relaxation, and rejuvenate your spirit through carefully selected essential oils tailored just for you. Enjoy a moment of calm and uplift your wellbeing.",
		goodFor: ["Muscle tension and tight shoulders", "Stress and overthinking", "General unwinding"],
		priceLabel: "£60",
		durationLabel: "1 hour",
		expect: [
			"A quick check-in on pressure preference and any problem areas.",
			"Warm oils and slow, flowing full-body strokes.",
			"Extra time on the shoulders and neck if that is where you hold tension.",
			"A relaxed finish, with no rush back out the door.",
		],
		aftercare: [
			"Drink water afterwards to help your muscles recover.",
			"A warm bath or shower that evening can extend the relaxation.",
			"Mild muscle tenderness for a day is normal after a firmer massage.",
			"Try to keep the rest of the day unhurried if you can.",
		],
		bookingUrl,
	},
	{
		slug: "face-massage",
		category: "massage",
		index: "03.",
		name: "Face Massage",
		image: "/images/gallery/massage/2.jpg",
		imagePosition: "center",
		alt: "Face, neck and shoulder massage treatment at Lafeli Beauty in Willaston",
		description:
			"A lifting, soothing massage for the face, neck and shoulders, the area that tends to hold the most tension without you noticing. Firm jaws, tight temples and a stiff neck from screen time are all addressed with slow, sculpting strokes that leave your skin looking brighter and your whole face feeling lighter. It is a lovely treatment on its own, or paired with a body massage for a longer session at the Willaston studio.",
		goodFor: ["Tension in the jaw and temples", "Tired-looking skin", "Neck and shoulder tightness"],
		priceLabel: "Price on Fresha", // TODO: price from Fresha
		durationLabel: "Duration on Fresha", // TODO: duration from Fresha
		expect: [
			"Skin is cleansed and prepped before we begin.",
			"Slow, lifting strokes across the face, jaw and hairline.",
			"Massage extends down into the neck and shoulders.",
			"A cool, calming finish to leave your skin glowing.",
		],
		aftercare: [
			"Avoid heavy makeup for a few hours to let your skin breathe.",
			"Drink water, as massage encourages gentle detoxification.",
			"Skin may look slightly flushed straight after; this settles quickly.",
			"Use your usual SPF the next day as normal.",
		],
		bookingUrl,
	},
	{
		slug: "waxing",
		category: "waxing",
		index: "04.",
		name: "Waxing",
		image: "/images/gallery/waxing-brows/1.jpg",
		imagePosition: "25% 55%",
		alt: "Waxing treatment at Lafeli Beauty in Willaston",
		description:
			"Reveal beautifully smooth skin with expert waxing, designed for effortless maintenance and a polished look. We use a specialised two-wax system for maximum comfort and skin care.",
		goodFor: ["Smooth, longer-lasting results", "Sensitive-skin friendly technique", "Quick appointments"],
		priceLabel: "From £8",
		durationLabel: "20 mins",
		menu: [
			{
				name: "Stomach / abdomen or centre line wax",
				duration: "20 mins",
				price: "from £8",
				note: "Price starts at £8 for the abdomen line and goes up to £23 for a full abdomen.",
			},
			{
				name: "Underarm wax",
				duration: "20 mins",
				price: "£14",
				note: "Gentle hot wax to protect delicate underarm skin. Moderate pain. Lasts 3 to 4 weeks.",
			},
		],
		notes: [
			"Precision Roller Wax: for arms and legs. Fast, clean, and perfectly suited for larger areas.",
			"Premium Calming Hot Wax: for delicate zones (underarms and intimate areas). It shrink-wraps the hair without tugging delicate skin.",
			"Finished with a soothing lavender post-wax oil.",
		],
		expect: [
			"A quick skin check, and a patch test area if it is your first time.",
			"Skin is cleansed and prepped with a pre-wax oil.",
			"Wax is applied and removed in small, controlled sections.",
			"A soothing after-oil is applied to calm the skin.",
		],
		aftercare: [
			"Avoid hot baths, saunas and sunbeds for 24 to 48 hours.",
			"Skip tight clothing over the area for the rest of the day.",
			"Gentle exfoliation after a few days helps prevent ingrown hairs.",
			"Mild redness is normal and usually settles within a few hours.",
		],
		bookingUrl,
	},
	{
		slug: "nails",
		category: "nails",
		index: "05.",
		name: "Nails",
		image: "/images/gallery/nails/5.jpg",
		imagePosition: "center",
		alt: "Brazilian manicure and pedicure treatment at Lafeli Beauty in Willaston",
		description:
			"Brazilian manicures and pedicures with a clean, polished result, a technique known for its careful cuticle work and neat, natural-looking finish. Nails are shaped, tidied and finished with your choice of polish or a simple buff, so hands and feet look genuinely well cared for rather than just painted. A popular add-on to a massage appointment, or a lovely stand-alone treat at the Willaston studio.",
		goodFor: ["Neat, natural-looking finish", "Careful cuticle care", "Hands and feet together"],
		priceLabel: "Price on Fresha", // TODO: price from Fresha
		durationLabel: "Duration on Fresha", // TODO: duration from Fresha
		expect: [
			"Nails are soaked, cleaned and shaped to your preference.",
			"Careful cuticle work using the Brazilian technique.",
			"A hand or foot massage while everything sets.",
			"Polish, buff or finish of your choice applied last.",
		],
		aftercare: [
			"Avoid submerging hands or feet in water for a couple of hours.",
			"Apply cuticle oil regularly to keep the finish looking fresh.",
			"Wear open shoes for a little while after a pedicure if you can.",
			"Book a top-up every few weeks to keep nails neat.",
		],
		bookingUrl,
	},
	{
		slug: "eyebrows",
		category: "brows",
		index: "06.",
		name: "Eyebrows",
		image: "/images/gallery/waxing-brows/2.jpg",
		imagePosition: "40% 65%",
		alt: "Eyebrow shaping treatment at Lafeli Beauty in Willaston",
		description:
			"Transform your look with perfectly shaped eyebrows that beautifully frame your face. Our expert eyebrow service, waxing or tweezers, offers a quick and effective way to achieve clean lines and a polished appearance, leaving you feeling fresh and confident.",
		goodFor: ["A polished, defined shape", "Quick top-ups", "Pairs well with other treatments"],
		priceLabel: "£11",
		durationLabel: "15 mins",
		expect: [
			"A brief chat about the shape you are after.",
			"Brows mapped out before any hair is removed.",
			"Shaping using wax, tweezers, or a combination of both.",
			"A cooling after-balm to calm the skin.",
		],
		aftercare: [
			"Avoid touching or applying makeup to the brow area for a few hours.",
			"Skip exfoliants or retinol products on the area for a day or two.",
			"Some light redness is normal and fades quickly.",
			"Avoid direct sun or sunbeds on the area for 24 hours.",
		],
		bookingUrl,
	},
	{
		slug: "body-and-face-sculpt-ritual",
		category: "bundles",
		index: "07.",
		name: "The Brazilian Body & Face Sculpt Ritual",
		image: "/images/hero/pexels-facial-treatment.jpg",
		imagePosition: "center",
		alt: "Facial treatment, part of the Brazilian Body and Face Sculpt Ritual bundle at Lafeli Beauty in Willaston",
		description:
			"Indulge in a transformative experience with our exclusive aesthetic bundle designed to rejuvenate both body and mind. Enjoy the captivating Lafeli Signature Facial, where your skin will receive the ultimate pampering and care, lasting for 75 minutes of pure bliss. Complementing this luxurious facial, the Brazilian Lymphatic Drainage boosts your body's natural detox processes. This harmonious combination is perfect for those seeking a comprehensive approach to self-care, helping you emerge feeling refreshed and revitalised. Discover a new level of relaxation and radiance today.",
		goodFor: ["A full self-care session", "Face and body together", "Saving 20%"],
		priceLabel: "£116",
		wasPrice: "£145",
		durationLabel: "2 hours 15 mins",
		badges: ["Save 20%", "2 services", "Female only"],
		menu: [
			{ name: "Lafeli Signature Facial", duration: "75 mins", price: "" },
			{ name: "Brazilian Lymphatic Drainage", duration: "1 hour", price: "" },
		],
		expect: [
			"A 75 minute Lafeli Signature Facial for your skin.",
			"A Brazilian Lymphatic Drainage session to support your body's natural detox processes.",
			"Both treatments booked together in one 2 hour 15 minute visit.",
		], // TODO: confirm the running order and any extra detail with Lili.
		aftercare: [
			"Drink plenty of water over the following 24 hours.",
			"Avoid alcohol and very salty food on the day of your treatment.",
			"Use your usual SPF the next day as normal.",
		],
		bookingUrl,
	},
];

const filters = [
	{ key: "all", label: "All" },
	{ key: "massage", label: "Massage" },
	{ key: "waxing", label: "Waxing" },
	{ key: "nails", label: "Nails" },
	{ key: "brows", label: "Brows" },
	{ key: "bundles", label: "Bundles" },
];

const finderQuestions = [
	{
		question: "What do you want?",
		options: [
			{ label: "To relax", value: "relax" },
			{ label: "To reduce puffiness", value: "puffiness" },
			{ label: "To look polished", value: "polished" },
		],
	},
	{
		question: "Where?",
		options: [
			{ label: "Body", value: "body" },
			{ label: "Face", value: "face" },
			{ label: "Hands and feet", value: "hands-feet" },
			{ label: "Brows", value: "brows" },
		],
	},
];

const timelineSteps = [
	{ title: "Book on Fresha", body: "Choose your treatment and a time that works for you, online in a minute." },
	{ title: "Arrive at the home studio", body: "Find me at 70 Colleys Lane, Willaston, Nantwich, a calm, private space." },
	{ title: "A quick chat", body: "We talk through what you need and any areas to focus on or avoid." },
	{ title: "Your treatment", body: "Settle in and let the session do its work, in English or Portuguese." },
	{ title: "Aftercare tips", body: "You will leave knowing exactly how to look after the results." },
];

const whyPoints = [
	{ title: "Qualified massage therapist", body: "Every massage treatment is carried out by a qualified therapist, with your comfort and safety front of mind." },
	{ title: "A calm home studio", body: "Tucked away in Willaston, the studio is private and quiet, a proper break from a busy day rather than a clinical waiting room." },
	{ title: "English and Portuguese spoken", body: "Treatments are available in English or Portuguese, whichever you are more comfortable with." },
	{ title: "Easy online booking", body: "See availability and book in a minute through Fresha, with WhatsApp on hand for any questions first." },
];


const pageTitle = "Treatments & Prices | Massage, Waxing & Nails in Nantwich | Lafeli Beauty";
const pageDescription =
	"Massage, lymphatic drainage, waxing, nails and brows at Lafeli Beauty in Willaston, Nantwich. See treatments and book online on Fresha.";

// --- JSON-LD ---
const localBusinessSchema = {
	"@context": "https://schema.org",
	"@type": "BeautySalon",
	name: "Lafeli Beauty",
	address: {
		"@type": "PostalAddress",
		streetAddress: "70 Colleys Lane",
		addressLocality: "Willaston, Nantwich",
		postalCode: "CW5 6NT",
		addressCountry: "GB",
	},
	telephone: phone,
	url: "https://lafelibeauty.co.uk/pricing", // TODO: confirm live domain for schema url
	sameAs: [instagramUrl, facebookUrl],
};

const offerCatalogSchema = {
	"@context": "https://schema.org",
	"@type": "OfferCatalog",
	name: "Lafeli Beauty Treatments",
	itemListElement: treatments.map((t) => ({
		"@type": "Offer",
		itemOffered: {
			"@type": "Service",
			name: t.name,
			description: t.description,
			provider: { "@type": "BeautySalon", name: "Lafeli Beauty" },
			areaServed: "Nantwich, Cheshire",
		},
	})),
};

const faqSchema = {
	"@context": "https://schema.org",
	"@type": "FAQPage",
	mainEntity: faqs.map((f) => ({
		"@type": "Question",
		name: f.q,
		acceptedAnswer: { "@type": "Answer", text: f.a },
	})),
};
---

<BaseLayout title={pageTitle} description={pageDescription}>
	<script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
	<script type="application/ld+json" set:html={JSON.stringify(offerCatalogSchema)} />
	<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

	<main>
		<!-- 1. HERO -->
		<section class="p-hero grid-texture" id="p-hero">
			<div class="p-hero__inner">
				<p class="p-hero__eyebrow reveal-up" style="--d:0ms">
					<span>PRICING</span><PencilUnderline color="var(--color-accent)" thickness={2} />
				</p>
				<h1 class="p-hero__title reveal-up" style="--d:80ms">Treatments &amp; Prices in Willaston, Nantwich</h1>
				<p class="p-hero__body reveal-up" style="--d:160ms">
					Massage, lymphatic drainage, waxing, nails and brows, from a calm home studio just outside
					Nantwich, Cheshire. Prices and durations below match Fresha, where you can also see live availability.
				</p>
				<div class="p-hero__actions reveal-up" style="--d:240ms">
					<a class="p-hero__button p-hero__button--filled" href={bookingUrl} target="_blank" rel="noopener noreferrer">
						<span class="p-hero__button-bg" aria-hidden="true"></span>
						<span class="p-hero__button-edge" aria-hidden="true"></span>
						<span class="p-hero__button-label" data-label="Book on Fresha">Book on Fresha</span>
					</a>
					<a class="p-hero__button p-hero__button--outline" href={whatsappUrl} target="_blank" rel="noopener noreferrer">
						<span class="p-hero__button-label-plain">Ask on WhatsApp</span>
					</a>
				</div>
			</div>
		</section>


		<!-- 2. FILTER CHIPS -->
		<div class="p-filters-wrap">
			<nav class="p-filters" data-filters aria-label="Filter treatments by category">
				{
					filters.map((f, i) => (
						<button
							type="button"
							class="p-filters__chip"
							data-filter-chip
							data-filter={f.key}
							aria-pressed={i === 0 ? "true" : "false"}
						>
							{f.label}
						</button>
					))
				}
				<span class="p-filters__underline" data-filters-underline aria-hidden="true"></span>
			</nav>
		</div>

		<!-- 3. TREATMENT LIST -->
		<section class="p-treatments" id="treatments" aria-label="Treatment list">
			{
				treatments.map((t, i) => (
					<article
						class="p-treatment reveal-up"
						data-treatment
						data-category={t.category}
						id={t.slug}
					>
						<div class:list={["p-treatment__row", { "p-treatment__row--reverse": i % 2 === 1 }]}>
							<div class="p-treatment__media" data-reveal-media>
								<img
									class="p-treatment__img"
									src={t.image}
									alt={t.alt}
									loading="lazy"
									style={`object-position:${t.imagePosition};`}
								/>
							</div>

							<div class="p-treatment__content">
								<p class="p-treatment__index">{t.index}</p>
								<h3 class="p-treatment__name">{t.name}</h3>
								<p class="p-treatment__description">{t.description}</p>

								{t.menu && (
									<ul class="p-menu" aria-label={`${t.name} services`}>
										{t.menu.map((m) => (
											<li class="p-menu__item">
												<div class="p-menu__main">
													<span class="p-menu__name">{m.name}</span>
													<span class="p-menu__meta">{m.duration}</span>
												</div>
												{m.price && <span class="p-menu__price">{m.price}</span>}
												{m.note && <p class="p-menu__note">{m.note}</p>}
											</li>
										))}
									</ul>
								)}

								{t.notes && (
									<div class="p-notes">
										<span class="p-notes__label">Good to know</span>
										<ul class="p-notes__list">
											{t.notes.map((n) => (
												<li>{n}</li>
											))}
										</ul>
									</div>
								)}

								<div class="p-treatment__goodfor">
									<span class="p-treatment__goodfor-label">Good for</span>
									<ul class="p-treatment__tags">
										{t.goodFor.map((g) => (
											<li class="p-treatment__tag">{g}</li>
										))}
									</ul>
								</div>

								<!-- Prices and durations are from Fresha. TODO: Face Massage and Nails
								     still show "Price on Fresha" until their Fresha listings are supplied. -->
								<div class="p-treatment__pills">
									<span class="p-treatment__pill">
										{t.wasPrice && <s class="p-treatment__was">{t.wasPrice}</s>} {t.priceLabel}
									</span>
									<span class="p-treatment__pill p-treatment__pill--outline">{t.durationLabel}</span>
									{t.badges?.map((b) => <span class="p-treatment__pill p-treatment__pill--accent">{b}</span>)}
								</div>

								<div class="p-accordion" data-accordion>
									<button class="p-accordion__trigger" type="button" data-accordion-trigger aria-expanded="false">
										<span>What to expect</span>
										<span class="p-accordion__icon" aria-hidden="true">+</span>
									</button>
									<div class="p-accordion__panel" data-accordion-panel>
										<div class="p-accordion__panel-inner">
											<ol class="p-accordion__list">
												{t.expect.map((step) => (
													<li>{step}</li>
												))}
											</ol>
										</div>
									</div>
								</div>

								<div class="p-accordion" data-accordion>
									<button class="p-accordion__trigger" type="button" data-accordion-trigger aria-expanded="false">
										<span>Before and aftercare</span>
										<span class="p-accordion__icon" aria-hidden="true">+</span>
									</button>
									<div class="p-accordion__panel" data-accordion-panel>
										<div class="p-accordion__panel-inner">
											<ul class="p-accordion__list">
												{t.aftercare.map((step) => (
													<li>{step}</li>
												))}
											</ul>
										</div>
									</div>
								</div>

								<a
									class="p-treatment__book"
									href={t.bookingUrl}
									target="_blank"
									rel="noopener noreferrer"
								>
									<span class="p-treatment__book-bg" aria-hidden="true"></span>
									<span class="p-treatment__book-edge" aria-hidden="true"></span>
									<span class="p-treatment__book-label" data-label={`Book ${t.name}`}>Book this treatment</span>
								</a>
							</div>
						</div>
					</article>
				))
			}
		</section>


		<!-- 4. TREATMENT FINDER -->
		<section class="p-finder" id="finder" aria-label="Treatment finder">
			<div class="p-finder__header">
				<p class="p-finder__eyebrow reveal-up">
					<span>Not sure what to book?</span><PencilUnderline color="var(--color-accent)" thickness={2} />
				</p>
				<h2 class="p-finder__title reveal-up" style="--d:80ms">Find your treatment in two taps</h2>
			</div>

			<div class="p-finder__box reveal-up" style="--d:160ms" data-finder>
				<!-- Step 0 -->
				<div class="p-finder__step" data-finder-step="0">
					<p class="p-finder__question">{finderQuestions[0].question}</p>
					<div class="p-finder__options">
						{finderQuestions[0].options.map((o) => (
							<button type="button" class="p-finder__option" data-finder-answer="0" data-value={o.value}>
								{o.label}
							</button>
						))}
					</div>
				</div>

				<!-- Step 1 -->
				<div class="p-finder__step" data-finder-step="1" hidden>
					<p class="p-finder__question">{finderQuestions[1].question}</p>
					<div class="p-finder__options">
						{finderQuestions[1].options.map((o) => (
							<button type="button" class="p-finder__option" data-finder-answer="1" data-value={o.value}>
								{o.label}
							</button>
						))}
					</div>
				</div>

				<!-- Result -->
				<div class="p-finder__step p-finder__result" data-finder-step="result" hidden>
					<p class="p-finder__result-label">We would recommend</p>
					<h3 class="p-finder__result-name" data-finder-result-name></h3>
					<p class="p-finder__result-desc" data-finder-result-desc></p>
					<div class="p-finder__result-actions">
						<a class="p-finder__result-book" data-finder-result-book href={bookingUrl} target="_blank" rel="noopener noreferrer">
							Book this treatment
						</a>
						<button type="button" class="p-finder__restart" data-finder-restart>Start again</button>
					</div>
				</div>
			</div>
		</section>

		<!-- 5. FIRST VISIT TIMELINE -->
		<section class="p-timeline" id="first-visit">
			<div class="p-timeline__header">
				<p class="p-timeline__eyebrow reveal-up">
					<span>First time here?</span><PencilUnderline color="var(--color-accent)" thickness={2} />
				</p>
				<h2 class="p-timeline__title reveal-up" style="--d:80ms">Your first visit</h2>
			</div>

			<ol class="p-timeline__list" data-timeline>
				<span class="p-timeline__spine" aria-hidden="true"><span class="p-timeline__spine-fill" data-timeline-fill></span></span>
				{
					timelineSteps.map((step, i) => (
						<li class="p-timeline__item" data-timeline-item>
							<span class="p-timeline__dot" aria-hidden="true">{i + 1}</span>
							<div class="p-timeline__item-content">
								<p class="p-timeline__item-title">{step.title}</p>
								<p class="p-timeline__item-body">{step.body}</p>
							</div>
						</li>
					))
				}
			</ol>
		</section>


		<!-- 6. WHY LAFELI -->
		<section class="p-why" id="why-lafeli">
			<div class="p-why__header">
				<p class="p-why__eyebrow reveal-up">
					<span>Why Lafeli Beauty</span><PencilUnderline color="var(--color-accent)" thickness={2} />
				</p>
				<h2 class="p-why__title reveal-up" style="--d:80ms">A studio built around you</h2>
			</div>
			<div class="p-why__grid">
				{
					whyPoints.map((point, i) => (
						<div class="p-why__card reveal-up" style={`--d:${i * 80}ms`}>
							<span class="p-why__card-bar" aria-hidden="true" />
							<p class="p-why__card-title">{point.title}</p>
							<p class="p-why__card-body">{point.body}</p>
						</div>
					))
				}
			</div>
		</section>

		<Faq />

		<!-- 8. FINAL CTA -->
		<section class="p-cta">
			<div class="p-cta__inner reveal-up">
				<h2 class="p-cta__title">Ready when you are.</h2>
				<p class="p-cta__body">Book online in a minute, or message me on WhatsApp if you have a question first.</p>
				<div class="p-cta__actions">
					<a class="p-hero__button p-hero__button--filled" href={bookingUrl} target="_blank" rel="noopener noreferrer">
						<span class="p-hero__button-bg" aria-hidden="true"></span>
						<span class="p-hero__button-edge" aria-hidden="true"></span>
						<span class="p-hero__button-label" data-label="Book on Fresha">Book on Fresha</span>
					</a>
					<a class="p-hero__button p-hero__button--outline p-hero__button--outline-dark" href={whatsappUrl} target="_blank" rel="noopener noreferrer">
						<span class="p-hero__button-label-plain">Ask on WhatsApp</span>
					</a>
				</div>
			</div>
		</section>
	</main>
</BaseLayout>

<style>
