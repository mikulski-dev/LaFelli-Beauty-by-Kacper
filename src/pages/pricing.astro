</style>

<script>
	// --- Reveal-on-scroll (fade + lift), one-shot, respects reduced motion.
	const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
	const revealEls = document.querySelectorAll<HTMLElement>(".reveal-up");

	if (reduceMotion) {
		revealEls.forEach((el) => el.classList.add("is-visible"));
	} else {
		const revealIo = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (!entry.isIntersecting) continue;
					entry.target.classList.add("is-visible");
					revealIo.unobserve(entry.target);
				}
			},
			{ threshold: 0.12, rootMargin: "0px 0px -8% 0px" },
		);
		revealEls.forEach((el) => revealIo.observe(el));
	}

	// --- Treatment media clip-path wipe reveal, one-shot.
	const mediaEls = document.querySelectorAll<HTMLElement>("[data-reveal-media]");
	if (reduceMotion) {
		mediaEls.forEach((el) => el.classList.add("is-revealed"));
	} else {
		const mediaIo = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (!entry.isIntersecting) continue;
					entry.target.classList.add("is-revealed");
					mediaIo.unobserve(entry.target);
				}
			},
			{ threshold: 0.2 },
		);
		mediaEls.forEach((el) => mediaIo.observe(el));
	}

	// --- Filter chips ---
	const chips = document.querySelectorAll<HTMLButtonElement>("[data-filter-chip]");
	const underline = document.querySelector<HTMLElement>("[data-filters-underline]");
	const treatmentCards = document.querySelectorAll<HTMLElement>("[data-treatment]");

	function moveUnderline(chip: HTMLElement) {
		if (!underline) return;
		underline.style.left = `${chip.offsetLeft}px`;
		underline.style.width = `${chip.offsetWidth}px`;
	}

	function applyFilter(filter: string) {
		treatmentCards.forEach((card) => {
			const match = filter === "all" || card.dataset.category === filter;
			card.hidden = !match;
		});
	}

	chips.forEach((chip) => {
		chip.addEventListener("click", () => {
			chips.forEach((c) => c.setAttribute("aria-pressed", "false"));
			chip.setAttribute("aria-pressed", "true");
			moveUnderline(chip);
			applyFilter(chip.dataset.filter ?? "all");
		});
	});

	const activeChip = document.querySelector<HTMLElement>('[data-filter-chip][aria-pressed="true"]');
	if (activeChip) {
		// Wait a tick so layout/fonts are settled before measuring.
		requestAnimationFrame(() => moveUnderline(activeChip));
		window.addEventListener("resize", () => {
			const current = document.querySelector<HTMLElement>('[data-filter-chip][aria-pressed="true"]') || activeChip;
			moveUnderline(current);
		});
	}

	// --- Accordions (pure CSS height transition via inline px height) ---
	const accordionTriggers = document.querySelectorAll<HTMLButtonElement>("[data-accordion-trigger]");

	accordionTriggers.forEach((trigger) => {
		const panel = trigger.nextElementSibling as HTMLElement | null;
		if (!panel) return;

		trigger.addEventListener("click", () => {
			const isOpen = trigger.getAttribute("aria-expanded") === "true";

			if (isOpen) {
				panel.style.height = `${panel.scrollHeight}px`;
				requestAnimationFrame(() => {
					panel.style.height = "0px";
				});
				trigger.setAttribute("aria-expanded", "false");
			} else {
				panel.style.height = `${panel.scrollHeight}px`;
				trigger.setAttribute("aria-expanded", "true");
				panel.addEventListener(
					"transitionend",
					() => {
						if (trigger.getAttribute("aria-expanded") === "true") panel.style.height = "auto";
					},
					{ once: true },
				);
			}
		});
	});

	// --- Treatment finder ---
	const finderBox = document.querySelector<HTMLElement>("[data-finder]");
	if (finderBox) {
		const steps = {
			0: finderBox.querySelector<HTMLElement>('[data-finder-step="0"]'),
			1: finderBox.querySelector<HTMLElement>('[data-finder-step="1"]'),
			result: finderBox.querySelector<HTMLElement>('[data-finder-step="result"]'),
		};

		const treatmentData: Record<string, { name: string; description: string; href: string }> = {};
		document.querySelectorAll<HTMLElement>("[data-treatment]").forEach((card) => {
			const name = card.querySelector<HTMLElement>(".p-treatment__name")?.textContent?.trim() ?? "";
			const description = card.querySelector<HTMLElement>(".p-treatment__description")?.textContent?.trim() ?? "";
			const href = card.querySelector<HTMLAnchorElement>(".p-treatment__book")?.href ?? "";
			treatmentData[card.id] = { name, description, href };
		});

		const finderResults: Record<string, string> = {
			"relax-body": "relaxing-massage",
			"relax-face": "face-massage",
			"relax-hands-feet": "nails",
			"relax-brows": "eyebrows",
			"puffiness-body": "lymphatic-drainage-massage",
			"puffiness-face": "face-massage",
			"puffiness-hands-feet": "lymphatic-drainage-massage",
			"puffiness-brows": "lymphatic-drainage-massage",
			"polished-body": "waxing",
			"polished-face": "waxing",
			"polished-hands-feet": "nails",
			"polished-brows": "eyebrows",
		};

		let answer0 = "";

		function showStep(step: "0" | "1" | "result") {
			(["0", "1", "result"] as const).forEach((key) => {
				const el = steps[key];
				if (!el) return;
				el.hidden = key !== step;
			});
		}

		finderBox.querySelectorAll<HTMLButtonElement>('[data-finder-answer="0"]').forEach((btn) => {
			btn.addEventListener("click", () => {
				answer0 = btn.dataset.value ?? "";
				showStep("1");
			});
		});

		finderBox.querySelectorAll<HTMLButtonElement>('[data-finder-answer="1"]').forEach((btn) => {
			btn.addEventListener("click", () => {
				const answer1 = btn.dataset.value ?? "";
				const slug = finderResults[`${answer0}-${answer1}`] ?? "relaxing-massage";
				const data = treatmentData[slug];

				const nameEl = finderBox.querySelector<HTMLElement>("[data-finder-result-name]");
				const descEl = finderBox.querySelector<HTMLElement>("[data-finder-result-desc]");
				const bookEl = finderBox.querySelector<HTMLAnchorElement>("[data-finder-result-book]");

				if (data && nameEl && descEl && bookEl) {
					nameEl.textContent = data.name;
					descEl.textContent = data.description;
					bookEl.href = data.href;
				}

				showStep("result");
			});
		});

		finderBox.querySelectorAll<HTMLButtonElement>("[data-finder-restart]").forEach((btn) => {
			btn.addEventListener("click", () => {
				answer0 = "";
				showStep("0");
			});
		});
	}

	// --- First-visit timeline: illuminate step by step on scroll ---
	const timelineItems = document.querySelectorAll<HTMLElement>("[data-timeline-item]");
	const timelineFill = document.querySelector<HTMLElement>("[data-timeline-fill]");

	if (timelineItems.length) {
		if (reduceMotion) {
			timelineItems.forEach((item) => item.classList.add("is-lit"));
			if (timelineFill) timelineFill.style.height = "100%";
		} else {
			let litCount = 0;
			const total = timelineItems.length;

			const timelineIo = new IntersectionObserver(
				(entries) => {
					for (const entry of entries) {
						if (!entry.isIntersecting) continue;
						entry.target.classList.add("is-lit");
						litCount += 1;
						if (timelineFill) timelineFill.style.height = `${(litCount / total) * 100}%`;
						timelineIo.unobserve(entry.target);
					}
				},
				{ threshold: 0.5 },
			);
			timelineItems.forEach((item) => timelineIo.observe(item));
		}
	}
</script>
