---
import { business } from "../lib/business";

// A single floating "Book now" pill (all screen sizes) that appears once the
// page is scrolled. It opens the Fresha booking page in a new tab.
---

<a class="qe-pill" href={business.bookingUrl} target="_blank" rel="noopener noreferrer" aria-label="Book now on Fresha">
	<span class="qe-pill__text">
		<span class="qe-pill__title">Book now</span>
	</span>
	<span class="qe-pill__arrow" aria-hidden="true">
		<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
	</span>
</a>

<style>
		.qe-pill {
			position: fixed;
			left: 50%;
			bottom: calc(0.9rem + env(safe-area-inset-bottom));
			z-index: 900;
			display: inline-flex;
			align-items: center;
			gap: 1rem;
			padding: 0.6rem 0.6rem 0.6rem 1.3rem;
			width: max-content;
			white-space: nowrap;
			border: 2px solid var(--shell);
			border-radius: 999px;
			background: var(--brown);
			color: #fff;
			font-family: var(--font-body);
			text-align: left;
			text-decoration: none;
			cursor: pointer;
			box-shadow: 0 12px 30px -10px rgba(74, 46, 38, 0.55);
			opacity: 0;
			transform: translate(-50%, 140%);
			pointer-events: none;
			transition: opacity 250ms var(--ease-standard), transform 300ms var(--ease-standard);
		}
		:global(html.qe-show) .qe-pill {
			opacity: 1;
			transform: translate(-50%, 0);
			pointer-events: auto;
		}
		.qe-pill__text {
			display: flex;
			flex-direction: column;
			line-height: 1.15;
		}
		.qe-pill__label {
			font-size: 0.65rem;
			letter-spacing: 0.16em;
			text-transform: uppercase;
			color: color-mix(in srgb, #fff 65%, transparent);
		}
		.qe-pill__title {
			font-size: 1rem;
			font-weight: 500;
			letter-spacing: 0.04em;
			text-transform: uppercase;
		}
		.qe-pill__arrow {
			display: grid;
			place-items: center;
			width: 2.6rem;
			height: 2.6rem;
			border-radius: 50%;
			background: var(--color-accent);
			color: var(--brown);
		}
		.qe-pill__arrow svg {
			width: 1.15rem;
			height: 1.15rem;
		}
</style>

<script>
	const root = document.documentElement;

	// The pill only shows once the page has been scrolled a little.
	const update = () => root.classList.toggle("qe-show", window.scrollY > 120);
	update();
	window.addEventListener("scroll", update, { passive: true });
</script>
