---
// Header: dark graphite bar, logo centred, with "Treatments" / "About Us" to
// its left and "Testimonials" / "Contact Us" to its right, kept
// symmetrical (no button or extra items on the far right).
import logoRose from "../assets/logo/lafeli-logo-rose-on-black.png";

const socials = [
	{ label: "Instagram", href: "https://www.instagram.com/lili_lafeli/" },
	{ label: "Facebook", href: "https://www.facebook.com/p/Lilly-Massage-Therapist-100089978122676/" },
];
---

<header class="sticky-nav" id="sticky-nav" data-sticky-nav data-visible="true">
	<nav class="sticky-nav__links sticky-nav__links--left" aria-label="Primary">
		<a href="/pricing">Treatments</a>
		<a href="/about">About Us</a>
	</nav>

	<a class="sticky-nav__logo" href="/">
		<img class="sticky-nav__logo-img" src={logoRose.src} width={logoRose.width} height={logoRose.height} alt="Lafeli Beauty" />
	</a>

	<nav class="sticky-nav__links sticky-nav__links--right" aria-label="Secondary">
		<a href="/testimonials">Testimonials</a>
		<a href="/contact">Contact Us</a>
	</nav>

	<button
		type="button"
		class="sticky-nav__burger"
		aria-haspopup="true"
		aria-expanded="false"
		aria-label="Open menu"
		data-burger-trigger
	>
		<span class="sticky-nav__burger-bar"></span>
		<span class="sticky-nav__burger-bar"></span>
		<span class="sticky-nav__burger-bar"></span>
	</button>
</header>

<div class="sticky-nav__mobile-panel" data-mobile-panel role="menu">
	<div class="sticky-nav__mobile-panel-scroll">
		<nav class="sticky-nav__mobile-panel-primary" aria-label="Secondary">
			<a href="/pricing" role="menuitem">Treatments</a>
			<a href="/about" role="menuitem">About Us</a>
			<a href="/testimonials" role="menuitem">Testimonials</a>
			<a href="/contact" role="menuitem">Contact Us</a>
		</nav>
		<div class="sticky-nav__mobile-panel-socials">
			{socials.map((s) => (
				<a href={s.href} target="_blank" rel="noopener noreferrer" role="menuitem">{s.label}</a>
			))}
		</div>
	</div>
</div>

<style>
	.sticky-nav {
		position: sticky;
		top: 0;
		left: 0;
		right: 0;
		z-index: 100;
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		gap: var(--space-5);
		padding: 0.45rem clamp(1.5rem, 4vw, 3.5rem);
		background: var(--color-graphite);
		color: #fff;
	}

	.sticky-nav__logo {
		justify-self: center;
		text-decoration: none;
	}

	.sticky-nav__logo-img {
		display: block;
		height: clamp(2.6rem, 5vw, 3.5rem);
		width: auto;
		filter: brightness(0) invert(1);
	}

	.sticky-nav__links {
		display: flex;
		align-items: center;
		gap: var(--space-5);
		font-family: var(--font-body);
		font-weight: 400;
		font-size: var(--text-xs);
		letter-spacing: 0.2em;
		text-transform: uppercase;
	}

	.sticky-nav__links--left {
		justify-self: start;
	}

	.sticky-nav__links--right {
		justify-self: end;
	}

	.sticky-nav__links a {
		position: relative;
		text-decoration: none;
		color: color-mix(in srgb, #fff 88%, transparent);
		transition: color 250ms var(--ease-standard);
	}

	.sticky-nav__links a::after {
		content: "";
		position: absolute;
		left: 0;
		right: 0;
		bottom: -0.35rem;
		height: 2px;
		background: var(--color-accent);
		transform: scaleX(0);
		transform-origin: left;
		transition: transform 250ms var(--ease-standard);
	}

	.sticky-nav__links a:hover {
		color: var(--color-accent);
	}

	.sticky-nav__links a:hover::after {
		transform: scaleX(1);
	}

	.sticky-nav__burger {
		all: unset;
		display: none;
		grid-column: 3;
		justify-self: end;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		gap: 5px;
		width: 2.25rem;
		height: 2.25rem;
		cursor: pointer;
		flex: none;
	}

	.sticky-nav__burger-bar {
		display: block;
		width: 1.35rem;
		height: 2px;
		background: #fff;
		transition: transform 250ms var(--ease-standard), opacity 250ms var(--ease-standard);
	}

	.sticky-nav__burger[aria-expanded="true"] .sticky-nav__burger-bar:nth-child(1) {
		transform: translateY(7px) rotate(45deg);
	}

	.sticky-nav__burger[aria-expanded="true"] .sticky-nav__burger-bar:nth-child(2) {
		opacity: 0;
	}

	.sticky-nav__burger[aria-expanded="true"] .sticky-nav__burger-bar:nth-child(3) {
		transform: translateY(-7px) rotate(-45deg);
	}

	.sticky-nav__mobile-panel {
		position: fixed;
		inset: 0;
		z-index: 99;
		display: none;
		flex-direction: column;
		width: 100%;
		height: 100%;
		overflow-y: auto;
		overscroll-behavior: contain;
		background: var(--color-graphite);
		opacity: 0;
		visibility: hidden;
		transform: translateX(100%);
		transition:
			opacity 380ms var(--ease-standard),
			transform 380ms var(--ease-standard),
			visibility 380ms;
	}

	.sticky-nav__mobile-panel[data-open="true"] {
		opacity: 1;
		visibility: visible;
		transform: translateX(0);
	}

	.sticky-nav__mobile-panel-scroll {
		flex: 1;
		overflow-y: auto;
		overscroll-behavior: contain;
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		gap: var(--space-5);
		padding: calc(var(--nav-height) + 0.85rem) var(--space-5) var(--space-4);
	}

	.sticky-nav__mobile-panel-primary {
		display: flex;
		flex-direction: column;
		align-items: center;
		width: 100%;
	}

	.sticky-nav__mobile-panel-primary a {
		text-decoration: none;
		color: #fff;
		font-size: var(--text-sm);
		font-weight: 400;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		padding: 0.85rem 0;
		width: 100%;
		max-width: 22rem;
		border-bottom: 1px solid color-mix(in srgb, #fff 15%, transparent);
		transition: color 250ms var(--ease-standard);
	}

	.sticky-nav__mobile-panel-primary a:last-child {
		border-bottom: none;
	}

	.sticky-nav__mobile-panel-primary a:hover,
	.sticky-nav__mobile-panel-primary a:focus-visible {
		color: var(--color-accent);
	}

	.sticky-nav__mobile-panel-socials {
		display: flex;
		gap: var(--space-4);
	}

	.sticky-nav__mobile-panel-socials a {
		text-decoration: none;
		color: color-mix(in srgb, #fff 60%, transparent);
		font-size: var(--text-xs);
		letter-spacing: 0.15em;
		text-transform: uppercase;
	}

	@media (max-width: 1024px) {
		.sticky-nav {
			display: flex;
			justify-content: center;
		}

		.sticky-nav__links {
			display: none;
		}

		.sticky-nav__burger {
			display: flex;
			position: absolute;
			right: clamp(1.5rem, 4vw, 3.5rem);
			top: 50%;
			transform: translateY(-50%);
		}

		.sticky-nav__mobile-panel {
			display: flex;
			overflow-y: auto;
		}
	}

	@media (max-width: 640px) {
		.sticky-nav {
			padding: var(--space-3) clamp(1.25rem, 5vw, 3.5rem);
			gap: var(--space-3);
		}
	}
</style>

<script>
	const burgerTrigger = document.querySelector<HTMLButtonElement>("[data-burger-trigger]");
	const mobilePanel = document.querySelector<HTMLElement>("[data-mobile-panel]");

	function closeMobilePanel() {
		if (!mobilePanel) return;
		mobilePanel.dataset.open = "false";
		burgerTrigger?.setAttribute("aria-expanded", "false");
		document.body.style.overflow = "";
	}

	function toggleMobilePanel() {
		if (!mobilePanel) return;
		const isOpen = mobilePanel.dataset.open === "true";
		mobilePanel.dataset.open = String(!isOpen);
		burgerTrigger?.setAttribute("aria-expanded", String(!isOpen));
		document.body.style.overflow = isOpen ? "" : "hidden";
	}

	burgerTrigger?.addEventListener("click", (event) => {
		event.stopPropagation();
		toggleMobilePanel();
	});

	mobilePanel?.addEventListener("click", (event) => {
		if ((event.target as HTMLElement).tagName === "A") closeMobilePanel();
	});

	window.addEventListener("resize", () => {
		if (window.innerWidth > 1024) closeMobilePanel();
	});

	window.addEventListener("pagehide", () => {
		document.body.style.overflow = "";
	});

	document.addEventListener("keydown", (event) => {
		if (event.key === "Escape") closeMobilePanel();
	});
</script>
