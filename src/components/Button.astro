---
// Site button (same construction as the pricing page / Hero buttons).
interface Props {
	href: string;
	label: string;
	variant?: "filled" | "outline" | "outline-light";
	external?: boolean;
}
const { href, label, variant = "filled", external = false } = Astro.props;
---

<a
	class:list={["btn", `btn--${variant}`]}
	href={href}
	target={external ? "_blank" : undefined}
	rel={external ? "noopener noreferrer" : undefined}
>
	{
		variant === "filled" ? (
			<>
				<span class="btn__bg" aria-hidden="true" />
				<span class="btn__edge" aria-hidden="true" />
				<span class="btn__label" data-label={label}>{label}</span>
			</>
		) : (
			<span class="btn__label-plain">{label}</span>
		)
	}
</a>

<style>
	.btn {
		--btn-pad: 0.85rem 1.6rem;
		position: relative;
		display: inline-flex;
		align-items: center;
		text-decoration: none;
		overflow: hidden;
		isolation: isolate;
		font-family: var(--font-body);
	}
	.btn--filled {
		background: var(--color-accent);
		color: var(--color-text);
	}
	.btn__bg {
		position: absolute;
		inset: 0;
		width: 2px;
		background: var(--color-text);
		transition: width 350ms var(--ease-standard);
		z-index: 0;
	}
	.btn--filled:hover .btn__bg,
	.btn--filled:focus-visible .btn__bg {
		width: 100%;
	}
	.btn__edge {
		position: absolute;
		left: 0;
		top: 0;
		bottom: 0;
		width: 2px;
		background: var(--color-accent);
		opacity: 0;
		z-index: 1;
		transition: opacity 350ms var(--ease-standard);
	}
	.btn--filled:hover .btn__edge,
	.btn--filled:focus-visible .btn__edge {
		opacity: 1;
	}
	.btn__label {
		position: relative;
		z-index: 1;
		display: inline-flex;
		align-items: center;
		font-size: var(--text-xs);
		font-weight: 400;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		padding: var(--btn-pad);
		white-space: nowrap;
		transition: transform 150ms var(--ease-standard);
	}
	.btn__label::after {
		content: attr(data-label);
		position: absolute;
		inset: 0;
		display: flex;
		align-items: center;
		padding: var(--btn-pad);
		color: #fff;
		clip-path: inset(0 100% 0 0);
		transition: clip-path 350ms var(--ease-standard);
		pointer-events: none;
	}
	.btn--filled:hover .btn__label::after,
	.btn--filled:focus-visible .btn__label::after {
		clip-path: inset(0 0 0 0);
	}
	.btn:active .btn__label {
		transform: scale(0.97);
	}
	.btn--outline,
	.btn--outline-light {
		border: 1px solid var(--color-text);
		color: var(--color-text);
		background: transparent;
		transition: background 250ms var(--ease-standard), color 250ms var(--ease-standard);
	}
	.btn--outline:hover,
	.btn--outline:focus-visible {
		background: var(--color-text);
		color: #fff;
	}
	.btn--outline-light {
		border-color: #fff;
		color: #fff;
	}
	.btn--outline-light:hover,
	.btn--outline-light:focus-visible {
		background: #fff;
		color: var(--color-graphite);
	}
	.btn__label-plain {
		font-size: var(--text-xs);
		font-weight: 400;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		padding: var(--btn-pad);
		white-space: nowrap;
	}
</style>
