---
// Thin vertical seam between two sections. Sits flush against the
// background (no added whitespace, no boxed background) and, once visible,
// has a light travel down it top to bottom on a loop.
---

<div class="section-divider" data-section-divider aria-hidden="true">
	<span class="section-divider__line"></span>
</div>

<style>
	.section-divider {
		--divider-h: clamp(1.5rem, 3vw, 2.25rem);
		position: relative;
		z-index: 2;
		display: flex;
		justify-content: center;
		height: var(--divider-h);
		background: transparent;
		pointer-events: none;
	}

	.section-divider__line {
		position: relative;
		width: 1px;
		height: 100%;
		background: var(--color-border);
		overflow: hidden;
	}

	.section-divider__line::after {
		content: "";
		position: absolute;
		left: 0;
		top: -40%;
		width: 100%;
		height: 40%;
		background: linear-gradient(
			to bottom,
			transparent 0%,
			var(--color-accent) 50%,
			transparent 100%
		);
		box-shadow: 0 0 8px 1px color-mix(in srgb, var(--color-accent) 60%, transparent);
		opacity: 0;
	}

	.section-divider.is-lit .section-divider__line::after {
		animation: divider-travel 4s ease-in-out infinite;
	}

	@keyframes divider-travel {
		0% {
			top: -40%;
			opacity: 0;
		}
		10% {
			opacity: 1;
		}
		85% {
			opacity: 1;
		}
		100% {
			top: 100%;
			opacity: 0;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.section-divider.is-lit .section-divider__line::after {
			animation: none;
		}
	}

	@media (max-width: 640px) {
		.section-divider {
			--divider-h: 3rem;
			margin-top: calc(var(--divider-h) * -1);
		}

		.section-divider__line {
			width: 1.5px;
		}
	}
</style>

<script>
	const io = new IntersectionObserver(
		(entries) => {
			for (const entry of entries) {
				if (!entry.isIntersecting) continue;
				entry.target.classList.add("is-lit");
				io.unobserve(entry.target);
			}
		},
		{ threshold: 0.4 },
	);

	document.querySelectorAll<HTMLElement>("[data-section-divider]").forEach((node) => io.observe(node));
</script>
