---
import PencilUnderline from "./PencilUnderline.astro";

// Contact section: a "Ready when you are" CTA band (Book + WhatsApp), then
// the same two-markup contact panel as before (desktop split at 1200px).
// No email address exists for the business, so the enquiry form opens
// WhatsApp with the message prefilled, rather than mailto.
const bookingUrl =
	"https://www.fresha.com/en-GB/a/lafeli-beauty-willaston-nantwich-70-colleys-lane-hq1yvezc/booking?menu=true&pId=3085259";
const whatsappUrl = "https://wa.me/447769379946";
---

<div class="contact__divider" aria-hidden="true"></div>

<section class="contact" id="contact" style="--accent: var(--color-accent)">
	<div class="contact__cta">
		<h2 class="contact__cta-title">Ready when you are.</h2>
		<p class="contact__cta-text">
			Book online in a minute, or message me on WhatsApp if you have a question.
		</p>
		<div class="contact__cta-actions">
			<a class="contact__cta-button contact__cta-button--filled" href={bookingUrl} target="_blank" rel="noopener noreferrer">
				<span class="contact__cta-button-bg" aria-hidden="true"></span>
				<span class="contact__cta-button-edge" aria-hidden="true"></span>
				<span class="contact__cta-button-label" data-label="Book">Book</span>
			</a>
			<a class="contact__cta-button contact__cta-button--outline" href={whatsappUrl} target="_blank" rel="noopener noreferrer">
				<span class="contact__cta-button-label-plain">WhatsApp</span>
			</a>
		</div>
	</div>

	<div class="contact-desktop">
		<div class="contact__header">
			<p class="contact__eyebrow">
				<span>Get in touch</span><PencilUnderline color="var(--accent)" thickness={2} />
			</p>
			<h2 class="contact__title">Get in touch</h2>
			<p class="contact__subtitle">
				Have a question before booking? Send a message and I'll come back to you as soon as I can.
			</p>
		</div>

		<div class="contact__panel">
			<div class="contact__intro">
				<p class="contact__intro-line">Lymphatic drainage.</p>
				<p class="contact__intro-line">Massage.</p>
				<p class="contact__intro-line">Waxing.</p>
				<p class="contact__intro-line contact__intro-line--last">Nails.</p>
				<p class="contact__intro-text">
					Private studio in Willaston, near Nantwich, Cheshire. Fill in the form and I'll get
					back to you on WhatsApp.
				</p>
				<p class="contact__direct-line">
					<span class="contact__direct-prefix">Phone -</span>
					<a class="contact__direct" href="tel:+447769379946">07769 379946</a>
				</p>
				<p class="contact__direct-line">
					<span class="contact__direct-prefix">WhatsApp -</span>
					<a class="contact__direct" href={whatsappUrl} target="_blank" rel="noopener noreferrer">Message Lili</a>
				</p>
				<p class="contact__direct-line">
					<span class="contact__direct-prefix">Studio -</span>
					<span class="contact__direct">70 Colleys Lane, Willaston, Nantwich CW5 6NT</span>
				</p>
			</div>

			<form class="contact__form" data-contact-form novalidate>
				<input class="enquiry-trap" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
				<div class="contact__row">
					<label class="contact__field">
						<span class="contact__label">Name</span>
						<input class="contact__input" type="text" name="name" required autocomplete="name" />
					</label>
					<label class="contact__field">
						<span class="contact__label">Phone</span>
						<input class="contact__input" type="tel" name="phone" autocomplete="tel" />
					</label>
				</div>

				<label class="contact__field">
					<span class="contact__label">Treatment</span>
					<select class="contact__input contact__input--select" name="treatment">
						<option value="">Select one</option>
						<option value="Lymphatic Drainage Massage">Lymphatic Drainage Massage</option>
						<option value="Relaxing Massage">Relaxing Massage</option>
						<option value="Face Massage">Face Massage</option>
						<option value="Waxing">Waxing</option>
						<option value="Nails">Nails</option>
						<option value="Eyebrows">Eyebrows</option>
						<option value="Other">Other</option>
					</select>
				</label>

				<label class="contact__field">
					<span class="contact__label">Message</span>
					<textarea class="contact__input contact__input--area" name="message" rows="3" required></textarea>
				</label>

				<button class="contact__submit" type="submit">
					<span class="contact__submit-bg" aria-hidden="true"></span>
					<span class="contact__submit-edge" aria-hidden="true"></span>
					<span class="contact__submit-label" data-label="Send enquiry">Send enquiry</span>
				</button>

				<p class="contact__status" data-contact-status role="status" aria-live="polite"></p>
			</form>
		</div>
	</div>

	<div class="contact-mobile">
		<div class="contact__header">
			<p class="contact__eyebrow">
				<span>Get in touch</span><PencilUnderline color="var(--accent)" thickness={2} />
			</p>
			<h2 class="contact__title">Get in touch</h2>
			<p class="contact__subtitle">
				Private studio in Willaston, near Nantwich, Cheshire. Fill in the form and I'll get back
				to you on WhatsApp, or message me directly.
			</p>
			<p class="contact__direct-row">
				<span class="contact__direct-item">
					<span class="contact__direct-label">Phone</span>
					<a class="contact__direct" href="tel:+447769379946">07769 379946</a>
				</span>
				<span class="contact__direct-item">
					<span class="contact__direct-label">WhatsApp</span>
					<a class="contact__direct" href={whatsappUrl} target="_blank" rel="noopener noreferrer">Message Lili</a>
				</span>
			</p>
		</div>

		<div class="contact__panel">
			<form class="contact__form" data-contact-form novalidate>
				<input class="enquiry-trap" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
				<div class="contact__row">
					<label class="contact__field">
						<span class="contact__label">Name</span>
						<input class="contact__input" type="text" name="name" required autocomplete="name" />
					</label>
					<label class="contact__field">
						<span class="contact__label">Phone</span>
						<input class="contact__input" type="tel" name="phone" autocomplete="tel" />
					</label>
				</div>

				<label class="contact__field">
					<span class="contact__label">Treatment</span>
					<select class="contact__input contact__input--select" name="treatment">
						<option value="">Select one</option>
						<option value="Lymphatic Drainage Massage">Lymphatic Drainage Massage</option>
						<option value="Relaxing Massage">Relaxing Massage</option>
						<option value="Face Massage">Face Massage</option>
						<option value="Waxing">Waxing</option>
						<option value="Nails">Nails</option>
						<option value="Eyebrows">Eyebrows</option>
						<option value="Other">Other</option>
					</select>
				</label>

				<label class="contact__field">
					<span class="contact__label">Message</span>
					<textarea class="contact__input contact__input--area" name="message" rows="3" required></textarea>
				</label>

				<button class="contact__submit" type="submit">
					<span class="contact__submit-bg" aria-hidden="true"></span>
					<span class="contact__submit-edge" aria-hidden="true"></span>
					<span class="contact__submit-label" data-label="Send enquiry">Send enquiry</span>
				</button>

				<p class="contact__status" data-contact-status role="status" aria-live="polite"></p>
			</form>
		</div>
	</div>
</section>

<style>
	.contact__divider {
		height: 1px;
		width: 100%;
		background: linear-gradient(
			to right,
			var(--color-bg-light) 0%,
			color-mix(in srgb, var(--color-graphite) 60%, var(--color-bg-light)) 50%,
			var(--color-bg-light) 100%
		);
	}

	.contact {
		box-sizing: border-box;
		background: var(--color-bg-light);
		color: var(--color-text);
	}

	.contact__cta {
		max-width: 40rem;
		margin: 0 auto;
		padding: var(--section-pad-y) var(--space-4) var(--space-6);
		text-align: center;
	}

	.contact__cta-title {
		font-family: var(--font-display);
		font-weight: 300;
		font-size: clamp(1.9rem, 3.2vw, var(--text-3xl));
		line-height: var(--leading-tight);
		margin: 0 0 var(--space-3);
	}

	.contact__cta-text {
		font-family: var(--font-body);
		font-weight: 300;
		font-size: calc(var(--text-lg) * 0.85);
		color: var(--color-text-muted);
		margin: 0 0 var(--space-4);
	}

	.contact__cta-actions {
		display: flex;
		justify-content: center;
		flex-wrap: wrap;
		gap: 1rem;
	}

	.contact__cta-button {
		--btn-pad: 0.85rem 1.6rem;
		position: relative;
		display: inline-flex;
		text-decoration: none;
		overflow: hidden;
		isolation: isolate;
		font-family: var(--font-body);
	}

	.contact__cta-button--filled {
		background: var(--accent);
		color: #fff;
	}

	.contact__cta-button-bg {
		position: absolute;
		inset: 0;
		width: 2px;
		background: var(--color-text);
		transition: width 350ms var(--ease-standard);
		z-index: 0;
	}

	.contact__cta-button--filled:hover .contact__cta-button-bg,
	.contact__cta-button--filled:focus-visible .contact__cta-button-bg {
		width: 100%;
	}

	.contact__cta-button-edge {
		position: absolute;
		left: 0;
		top: 0;
		bottom: 0;
		width: 2px;
		background: var(--accent);
		opacity: 0;
		z-index: 1;
		transition: opacity 350ms var(--ease-standard);
	}

	.contact__cta-button--filled:hover .contact__cta-button-edge,
	.contact__cta-button--filled:focus-visible .contact__cta-button-edge {
		opacity: 1;
	}

	.contact__cta-button-label {
		position: relative;
		z-index: 1;
		display: inline-flex;
		align-items: center;
		font-size: var(--text-xs);
		font-weight: 400;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		padding: var(--btn-pad);
		white-space: nowrap;
		transition: transform 150ms var(--ease-standard);
	}

	.contact__cta-button-label::after {
		content: attr(data-label);
		position: absolute;
		inset: 0;
		display: flex;
		align-items: center;
		padding: var(--btn-pad);
		color: #fff;
		clip-path: inset(0 100% 0 0);
		transition: clip-path 350ms var(--ease-standard);
		pointer-events: none;
	}

	.contact__cta-button--filled:hover .contact__cta-button-label::after,
	.contact__cta-button--filled:focus-visible .contact__cta-button-label::after {
		clip-path: inset(0 0 0 0);
	}

	.contact__cta-button--outline {
		align-items: center;
		border: 1px solid var(--color-text);
		color: var(--color-text);
		background: transparent;
		transition: background 250ms var(--ease-standard), color 250ms var(--ease-standard);
	}

	.contact__cta-button--outline:hover,
	.contact__cta-button--outline:focus-visible {
		background: var(--color-text);
		color: #fff;
	}

	.contact__cta-button-label-plain {
		font-size: var(--text-xs);
		font-weight: 400;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		padding: var(--btn-pad);
		white-space: nowrap;
	}

	.contact-desktop {
		display: block;
		padding-bottom: var(--section-pad-y);
	}

	.contact-mobile {
		display: none;
	}

	/* ---- Desktop (>=1200px): original layout, unchanged ---- */

	.contact-desktop .contact__header {
		max-width: 40rem;
		margin: 0 auto;
		padding: 0 clamp(2rem, 4.5vw, 4rem) var(--space-6);
		text-align: center;
	}

	.contact-desktop .contact__eyebrow {
		position: relative;
		display: inline-block;
		width: fit-content;
		font-family: var(--font-body);
		font-weight: 400;
		font-size: calc(var(--text-xs) * 0.85);
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: var(--color-text);
		margin: 0 0 var(--space-4);
	}

	.contact-desktop .contact__title {
		font-family: var(--font-display);
		font-weight: 300;
		font-size: clamp(1.9rem, 3.2vw, var(--text-3xl));
		line-height: var(--leading-tight);
		color: var(--color-text);
		margin: 0 0 var(--space-3);
	}

	.contact-desktop .contact__subtitle {
		font-family: var(--font-body);
		font-weight: 300;
		font-size: calc(var(--text-lg) * 0.85);
		color: var(--color-text-muted);
		line-height: var(--leading-normal);
		margin: 0;
	}

	.contact-desktop .contact__panel {
		position: relative;
		max-width: var(--content-width);
		margin: 0 auto;
		background: var(--color-graphite);
		box-sizing: border-box;
		display: grid;
		grid-template-columns: 0.85fr 1.15fr;
		overflow: hidden;
	}

	.contact-desktop .contact__intro {
		position: relative;
		padding: clamp(3rem, 5vw, 4rem) clamp(2rem, 4vw, 3rem);
		border-right: 1px solid color-mix(in srgb, #fff 12%, transparent);
	}

	.contact-desktop .contact__intro-line {
		font-family: var(--font-display);
		font-weight: 300;
		font-size: clamp(1.6rem, 2.6vw, 2.2rem);
		line-height: 1.05;
		color: var(--accent);
		margin: 0;
	}

	.contact-desktop .contact__intro-line--last {
		margin-bottom: 1.5rem;
	}

	.contact-desktop .contact__intro-text {
		font-family: var(--font-body);
		font-weight: 300;
		font-size: var(--text-sm);
		line-height: var(--leading-normal);
		color: color-mix(in srgb, #fff 65%, transparent);
		max-width: 22rem;
		margin: 0 0 var(--space-5);
	}

	.contact-desktop .contact__direct-line {
		display: flex;
		align-items: baseline;
		gap: 0.4em;
		margin: 0 0 var(--space-2);
	}

	.contact-desktop .contact__direct-prefix {
		font-size: var(--text-sm);
		font-weight: 400;
		color: color-mix(in srgb, #fff 65%, transparent);
	}

	.contact-desktop .contact__direct {
		width: fit-content;
		font-size: var(--text-sm);
		font-weight: 400;
		color: #fff;
		text-decoration: underline;
		text-underline-offset: 0.2em;
		text-decoration-color: color-mix(in srgb, #fff 35%, transparent);
		transition: text-decoration-color 250ms var(--ease-standard);
	}

	.contact-desktop .contact__direct:hover,
	.contact-desktop .contact__direct:focus-visible {
		text-decoration-color: var(--accent);
	}

	.contact-desktop .contact__form {
		display: flex;
		flex-direction: column;
		gap: var(--space-4);
		padding: clamp(3rem, 5vw, 4rem) clamp(2rem, 4vw, 3rem);
	}

	.contact-desktop .contact__row {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: var(--space-4);
	}

	/* ---- Mobile/tablet (<1200px): stacked graphite layout ---- */

	.contact-mobile .contact__header {
		max-width: 40rem;
		margin: 0 auto;
		padding: 0 clamp(2rem, 4.5vw, 4rem) var(--space-6);
		text-align: center;
	}

	.contact-mobile .contact__eyebrow {
		position: relative;
		display: inline-block;
		width: fit-content;
		font-family: var(--font-body);
		font-weight: 400;
		font-size: calc(var(--text-xs) * 0.85);
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: var(--color-text);
		margin: 0 0 var(--space-4);
	}

	.contact-mobile .contact__title {
		font-family: var(--font-display);
		font-weight: 300;
		font-size: clamp(1.9rem, 3.2vw, var(--text-3xl));
		line-height: var(--leading-tight);
		color: var(--color-text);
		margin: 0 0 var(--space-3);
	}

	.contact-mobile .contact__subtitle {
		font-family: var(--font-body);
		font-weight: 300;
		font-size: clamp(var(--text-base), 1.9vw, var(--text-lg));
		color: var(--color-text-muted);
		line-height: var(--leading-normal);
		max-width: 34rem;
		margin: 0 auto var(--space-5);
	}

	.contact-mobile .contact__direct-row {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: center;
		gap: 0.6em;
		margin: 0;
	}

	.contact-mobile .contact__direct-item {
		display: inline-flex;
		align-items: baseline;
		gap: 0.4em;
	}

	.contact-mobile .contact__direct-label {
		font-size: calc(var(--text-xs) * 0.85);
		font-weight: 400;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--color-text-muted);
	}

	.contact-mobile .contact__direct {
		width: fit-content;
		font-size: var(--text-sm);
		font-weight: 400;
		color: var(--color-text);
		text-decoration: underline;
		text-underline-offset: 0.2em;
		text-decoration-color: color-mix(in srgb, currentColor 35%, transparent);
		transition: text-decoration-color 250ms var(--ease-standard);
	}

	.contact-mobile .contact__direct:hover,
	.contact-mobile .contact__direct:focus-visible {
		text-decoration-color: var(--accent);
	}

	.contact-mobile .contact__panel {
		position: relative;
		max-width: var(--content-width);
		margin: 0 auto;
		background: var(--color-graphite);
		box-sizing: border-box;
		overflow: hidden;
	}

	.contact-mobile .contact__form {
		display: flex;
		flex-direction: column;
		gap: var(--space-4);
		padding: clamp(3rem, 5vw, 4rem) clamp(2rem, 4vw, 3rem) var(--section-pad-y);
	}

	.contact-mobile .contact__row {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: var(--space-4);
	}

	.contact-mobile .contact__submit {
		align-self: center;
	}

	/* ---- Shared field/button styling (identical in both) ---- */

	.contact__field {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.contact__label {
		font-family: var(--font-body);
		font-size: calc(var(--text-xs) * 0.85);
		font-weight: 400;
		letter-spacing: 0.15em;
		text-transform: uppercase;
		color: color-mix(in srgb, #fff 55%, transparent);
	}

	.contact__input {
		appearance: none;
		width: 100%;
		box-sizing: border-box;
		background: transparent;
		border: none;
		border-bottom: 1px solid color-mix(in srgb, #fff 30%, transparent);
		border-radius: 0;
		padding: 0.6rem 0;
		font-family: var(--font-body);
		font-weight: 300;
		font-size: var(--text-base);
		color: #fff;
		transition: border-color 250ms var(--ease-standard);
	}

	.contact__input::placeholder {
		color: color-mix(in srgb, #fff 40%, transparent);
	}

	.contact__input:focus {
		outline: none;
		border-bottom-color: var(--accent);
	}

	.contact__input--select {
		cursor: pointer;
	}

	.contact__input--select option {
		background: var(--color-graphite);
		color: #fff;
	}

	.contact__input--area {
		resize: vertical;
		min-height: 3.5rem;
	}

	.contact__submit {
		--btn-pad: 0.85rem 1.75rem;
		position: relative;
		display: inline-flex;
		align-self: flex-start;
		width: fit-content;
		background: var(--accent);
		color: #fff;
		border: none;
		text-decoration: none;
		overflow: hidden;
		isolation: isolate;
		cursor: pointer;
		margin-top: var(--space-2);
		font-family: var(--font-body);
	}

	.contact__submit-bg {
		position: absolute;
		inset: 0;
		width: 2px;
		background: #fff;
		transition: width 350ms var(--ease-standard);
		z-index: 0;
	}

	.contact__submit:hover .contact__submit-bg,
	.contact__submit:focus-visible .contact__submit-bg {
		width: 100%;
	}

	.contact__submit-edge {
		position: absolute;
		left: 0;
		top: 0;
		bottom: 0;
		width: 2px;
		background: var(--accent);
		opacity: 0;
		z-index: 1;
		transition: opacity 350ms var(--ease-standard);
	}

	.contact__submit:hover .contact__submit-edge,
	.contact__submit:focus-visible .contact__submit-edge {
		opacity: 1;
	}

	.contact__submit-label {
		position: relative;
		z-index: 1;
		display: inline-flex;
		align-items: center;
		font-size: var(--text-xs);
		font-weight: 400;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		padding: var(--btn-pad);
		white-space: nowrap;
		transition: transform 150ms var(--ease-standard);
	}

	.contact__submit-label::after {
		content: attr(data-label);
		position: absolute;
		inset: 0;
		display: flex;
		align-items: center;
		padding: var(--btn-pad);
		color: var(--accent);
		clip-path: inset(0 100% 0 0);
		transition: clip-path 350ms var(--ease-standard);
		pointer-events: none;
	}

	.contact__submit:hover .contact__submit-label::after,
	.contact__submit:focus-visible .contact__submit-label::after {
		clip-path: inset(0 0 0 0);
	}

	.contact__submit:active .contact__submit-label {
		transform: scale(0.97);
	}

	.contact__status:empty {
		display: none;
	}

	.contact__status {
		font-size: var(--text-xs);
		color: color-mix(in srgb, #fff 65%, transparent);
		margin: 0;
		min-height: 1em;
	}

	/* ---- Breakpoint switch: desktop <-> mobile/tablet ---- */

	@media (max-width: 1199px) {
		.contact-desktop {
			display: none;
		}

		.contact-mobile {
			display: block;
		}
	}

	@media (max-width: 1024px) {
		.contact-mobile .contact__header {
			padding: 0 var(--space-4) var(--space-5);
		}

		.contact-mobile .contact__row {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 640px) {
		.contact-mobile {
			background: var(--color-graphite);
		}

		.contact-mobile .contact__title,
		.contact-mobile .contact__eyebrow {
			color: #fff;
		}

		.contact-mobile .contact__subtitle {
			color: color-mix(in srgb, #fff 65%, transparent);
		}

		.contact-mobile .contact__direct-label {
			color: color-mix(in srgb, #fff 55%, transparent);
		}

		.contact-mobile .contact__direct {
			color: #fff;
		}
	}
</style>

<script>
	import { sendEnquiry, field, showEnquiryResult } from "../lib/enquiry";

	document.querySelectorAll<HTMLFormElement>("[data-contact-form]").forEach((form) => {
		const status = form.querySelector<HTMLElement>("[data-contact-status]");
		const label = form.querySelector<HTMLElement>(".contact__submit-label");
		const button = form.querySelector<HTMLButtonElement>("button[type=submit]");

		form.addEventListener("submit", async (event) => {
			event.preventDefault();
			const data = new FormData(form);
			const name = field(data, "name");
			const phone = field(data, "phone");
			const treatment = field(data, "treatment");
			const message = field(data, "message");

			if (!name || !message) {
				if (status) status.textContent = "Please add your name and a short message.";
				return;
			}

			const text = [
				`Hi Lili, it's ${name}.`,
				treatment && `I'm interested in: ${treatment}.`,
				phone && `My phone number: ${phone}.`,
				message,
			]
				.filter(Boolean)
				.join(" ");

			if (status) status.textContent = "";
			if (button) button.disabled = true;
			if (label) {
				label.textContent = "Sending…";
				label.dataset.label = "Sending…";
			}
			const ok = await sendEnquiry({
				form: "Contact section",
				name,
				phone,
				treatment,
				message,
				website: field(data, "website"),
			});
			showEnquiryResult(form, ok, name, text);
		});
	});
</script>
