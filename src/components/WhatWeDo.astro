---
import PencilUnderline from "./PencilUnderline.astro";

// Treatments stacked-card sequence. Every card links straight to the main
// Fresha booking URL, since per-treatment Fresha links don't exist yet.
// Full menu, prices and durations live on Fresha — no prices invented here.
//
// Structure: the heading and the card both live inside the sticky stage, so
// they pin together as one unit — "Treatments" + subtitle directly under the
// nav, with the active card below. The page locks there while the user
// scrolls through cards 01-06, then releases.
const bookingUrl =
	"https://www.fresha.com/en-GB/a/lafeli-beauty-willaston-nantwich-70-colleys-lane-hq1yvezc/booking?menu=true&pId=3085259";

const cards = [
	{
		index: "01.",
		name: "Face Massage",
		description: "Lifting, soothing massage for the face, neck and shoulders.",
		alt: "Face massage treatment at Lafeli Beauty",
		image: "/images/gallery/massage/face-massage.jpg",
		position: "center",
		reverse: false,
		enterX: "-120vw",
		enterY: "0vh",
	},
	{
		index: "02.",
		name: "Relaxing Massage",
		description: "A calm, full-body massage to release tension.",
		alt: "Relaxing full-body massage at Lafeli Beauty",
		image: "/images/gallery/massage/1.jpg",
		position: "center 72%",
		reverse: true,
		enterX: "120vw",
		enterY: "-18vh",
	},
	{
		index: "03.",
		name: "Lymphatic Drainage Massage",
		description: "Gentle, rhythmic massage to reduce puffiness and help you feel lighter.",
		alt: "Lymphatic drainage massage at Lafeli Beauty",
		image: "/images/gallery/drainage/1.jpg",
		position: "center",
		reverse: false,
		enterX: "-120vw",
		enterY: "12vh",
	},
	{
		index: "04.",
		name: "Waxing",
		description: "Quick, precise waxing with a gentle finish.",
		alt: "Waxing treatment at Lafeli Beauty",
		image: "/images/gallery/waxing-brows/1.jpg",
		position: "25% 55%",
		reverse: true,
		enterX: "120vw",
		enterY: "-12vh",
		compact: true,
	},
	{
		index: "05.",
		name: "Nails",
		description: "Brazilian manicures and pedicures with a clean, polished result.",
		alt: "Brazilian manicure and pedicure at Lafeli Beauty",
		image: "/images/gallery/nails/5.jpg",
		position: "center",
		reverse: false,
		enterX: "-120vw",
		enterY: "6vh",
	},
	{
		index: "06.",
		name: "Eyebrows",
		description: "Shaping to suit your face.",
		alt: "Eyebrow shaping at Lafeli Beauty",
		image: "/images/gallery/waxing-brows/2.jpg",
		position: "40% 65%",
		reverse: true,
		enterX: "120vw",
		enterY: "-6vh",
	},
];

const vhPerCard = 80;
---

<section class="what-we-do" id="what-we-do">
	<div
		class="what-we-do__track"
		data-wwd-track
		style={`height:calc(${cards.length * vhPerCard}vh + 100svh - var(--nav-height));`}
	>
		<div class="what-we-do__stage" data-wwd-stage>
			<div class="what-we-do__header">
				<p class="what-we-do__eyebrow">
					<span>This is what I do</span><PencilUnderline color="var(--color-accent)" thickness={2} />
				</p>
				<h2 class="what-we-do__title">Treatments</h2>
				<p class="what-we-do__subtitle">
					Every card links straight to booking. Full menu and prices are on Fresha.
				</p>
			</div>

			<div class="wwd-card-area">
				{
					cards.map((card, i) => (
						<a
							id={card.name.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "")}
							class:list={["wwd-card", { "wwd-card--reverse": card.reverse }]}
							data-wwd-item
							href={bookingUrl}
							target="_blank"
							rel="noopener noreferrer"
							style={`--enter-x:${card.enterX}; --enter-y:${card.enterY}; z-index:${i + 1};`}
						>
							<div class:list={["wwd-card__content", { "wwd-card__content--compact": card.compact }]}>
								<p class="wwd-card__eyebrow">
									<span>{card.index}</span>
								</p>
								<h3 class="wwd-card__name">{card.name}</h3>
								<p class="wwd-card__description">{card.description}</p>

								<span class="wwd-card__button">
									<span class="wwd-card__button-bg" aria-hidden="true" />
									<span class="wwd-card__button-edge" aria-hidden="true" />
									<span class="wwd-card__button-label">Book on Fresha</span>
								</span>
							</div>

							<div class="wwd-card__media">
								<img
								class="wwd-card__media-img"
								src={card.image}
								alt={card.alt}
								loading="lazy"
								style={`object-position:${card.position};`}
							/>
							</div>
						</a>
					))
				}

				<div class="wwd-scroll-hint wwd-scroll-hint--left" data-wwd-scroll-hint aria-hidden="true">
					<span class="wwd-scroll-hint__chevron" style="animation-delay:0ms" />
					<span class="wwd-scroll-hint__chevron" style="animation-delay:200ms" />
					<span class="wwd-scroll-hint__chevron" style="animation-delay:400ms" />
				</div>

				<div class="wwd-scroll-hint wwd-scroll-hint--right" data-wwd-scroll-hint aria-hidden="true">
					<span class="wwd-scroll-hint__chevron" style="animation-delay:0ms" />
					<span class="wwd-scroll-hint__chevron" style="animation-delay:200ms" />
					<span class="wwd-scroll-hint__chevron" style="animation-delay:400ms" />
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	.what-we-do {
		position: relative;
		box-sizing: border-box;
		background: var(--color-bg-light);
		color: var(--color-text);
	}

	.what-we-do__track {
		position: relative;
	}

	.what-we-do__stage {
		position: sticky;
		top: var(--nav-height);
		width: 100%;
		height: calc(100svh - var(--nav-height));
		overflow: hidden;
		background: var(--color-bg-light);
		box-sizing: border-box;
		display: flex;
		flex-direction: column;
		--wwd-card-h: clamp(20rem, 34vw, 28rem);
	}

	.what-we-do__header {
		position: relative;
		z-index: 1;
		flex: none;
		max-width: 40rem;
		margin: 0 auto;
		padding: 0.75rem var(--space-4) 0.25rem;
		text-align: center;
	}

	.what-we-do__eyebrow {
		position: relative;
		display: inline-block;
		width: fit-content;
		font-family: var(--font-body);
		font-weight: 400;
		font-size: calc(var(--text-xs) * 0.85);
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: var(--color-text);
		margin: 0 0 var(--space-2);
	}

	.what-we-do__title {
		font-family: var(--font-display);
		font-weight: 300;
		font-size: clamp(1.9rem, 3.2vw, var(--text-3xl));
		line-height: var(--leading-tight);
		color: var(--color-text);
		margin: 0 0 var(--space-2);
	}

	.what-we-do__subtitle {
		font-family: var(--font-body);
		font-weight: 300;
		font-size: calc(var(--text-lg) * 0.85);
		color: var(--color-text-muted);
		margin: 0;
	}

	.wwd-card-area {
		position: relative;
		flex: 1;
		min-height: 0;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.wwd-card {
		position: absolute;
		top: 50%;
		left: 50%;
		width: min(92vw, var(--content-width));
		height: var(--wwd-card-h);
		max-height: 92%;
		display: grid;
		grid-template-columns: 1fr 1fr;
		align-items: stretch;
		background: var(--color-graphite);
		border: 1px solid var(--color-border);
		overflow: hidden;
		text-decoration: none;
		transform: translate(-50%, -50%) translate(var(--enter-x, 0px), var(--enter-y, 0px));
		transition: transform 650ms cubic-bezier(0.76, 0, 0.24, 1);
	}

	.wwd-card.is-active {
		transform: translate(-50%, -50%);
	}

	.wwd-card:first-child.is-active {
		box-shadow: 0 40px 80px -20px rgba(74, 46, 38, 0.35);
	}

	.wwd-scroll-hint {
		position: absolute;
		top: 50%;
		transform: translateY(-50%);
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.35rem;
		z-index: 100;
		transition: opacity 400ms var(--ease-standard);
	}

	.wwd-scroll-hint--left {
		left: clamp(0.75rem, 2.5vw, 2rem);
	}

	.wwd-scroll-hint--right {
		right: clamp(0.75rem, 2.5vw, 2rem);
	}

	.wwd-scroll-hint.is-done {
		opacity: 0;
		pointer-events: none;
	}

	.wwd-scroll-hint__chevron {
		width: 0.85rem;
		height: 0.85rem;
		border-right: 2px solid var(--color-graphite);
		border-bottom: 2px solid var(--color-graphite);
		transform: rotate(45deg);
		opacity: 0.15;
		animation: wwd-chevron-pulse 1.8s ease-in-out infinite;
	}

	@keyframes wwd-chevron-pulse {
		0%,
		100% {
			opacity: 0.15;
		}
		30% {
			opacity: 1;
		}
	}

	.wwd-card--reverse .wwd-card__content {
		order: 2;
	}

	.wwd-card--reverse .wwd-card__media {
		order: 1;
	}

	.wwd-card__content {
		position: relative;
		z-index: 1;
		display: flex;
		flex-direction: column;
		justify-content: center;
		padding: clamp(1.25rem, 3vw, var(--section-pad-y)) clamp(2rem, 4vw, 4.5rem);
	}

	.wwd-card__content--compact {
		padding-top: clamp(0.75rem, 1.5vw, calc(var(--section-pad-y) * 0.4));
		padding-bottom: clamp(0.75rem, 1.5vw, calc(var(--section-pad-y) * 0.4));
	}

	.wwd-card__eyebrow {
		position: relative;
		display: inline-block;
		width: fit-content;
		font-family: var(--font-body);
		font-weight: 400;
		font-size: calc(var(--text-xs) * 0.85);
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: #fff;
		margin: 0 0 var(--space-3);
	}

	.wwd-card__name {
		font-family: var(--font-display);
		font-weight: 300;
		font-size: clamp(1.6rem, 2.8vw, var(--text-3xl));
		line-height: var(--leading-tight);
		color: #fff;
		margin: 0 0 var(--space-2);
	}

	.wwd-card__description {
		font-family: var(--font-body);
		font-weight: 300;
		font-size: calc(var(--text-lg) * 0.8);
		line-height: var(--leading-normal);
		color: color-mix(in srgb, #fff 70%, transparent);
		margin: 0;
		max-width: 30rem;
	}

	.wwd-card__button {
		--btn-pad: 0.65rem 1.4rem;
		position: relative;
		display: inline-flex;
		width: fit-content;
		margin-top: var(--space-3);
		background: var(--color-accent);
		color: var(--color-text);
		overflow: hidden;
		isolation: isolate;
	}

	.wwd-card__button-bg {
		position: absolute;
		inset: 0;
		width: 2px;
		background: #fff;
		transition: width 350ms var(--ease-standard);
		z-index: 0;
	}

	.wwd-card:hover .wwd-card__button-bg,
	.wwd-card:focus-visible .wwd-card__button-bg {
		width: 100%;
	}

	.wwd-card__button-edge {
		position: absolute;
		left: 0;
		top: 0;
		bottom: 0;
		width: 2px;
		background: #fff;
		z-index: 2;
		transition: background 350ms var(--ease-standard);
	}

	.wwd-card:hover .wwd-card__button-edge,
	.wwd-card:focus-visible .wwd-card__button-edge {
		background: var(--color-accent);
	}

	.wwd-card__button-label {
		position: relative;
		z-index: 1;
		display: inline-flex;
		align-items: center;
		font-size: var(--text-xs);
		font-weight: 400;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		padding: var(--btn-pad);
		white-space: nowrap;
		transition: transform 150ms var(--ease-standard), color 350ms var(--ease-standard);
	}

	.wwd-card:hover .wwd-card__button-label,
	.wwd-card:focus-visible .wwd-card__button-label {
		color: var(--brown);
	}

	.wwd-card:active .wwd-card__button-label {
		transform: scale(0.97);
	}

	.wwd-card__media {
		position: relative;
		z-index: 1;
		height: 100%;
		overflow: hidden;
	}

	.wwd-card__media-img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	@media (prefers-reduced-motion: reduce) {
		.wwd-card {
			transform: translate(-50%, -50%) !important;
		}
	}

	@media (max-width: 1024px) {
		.what-we-do__title {
			white-space: normal;
		}

		.wwd-card {
			width: 92vw;
			height: auto;
			max-height: 94%;
			grid-template-columns: 1fr;
			grid-template-rows: auto 1fr;
		}

		.wwd-card__content {
			padding: var(--space-4) var(--space-4);
			order: 2;
		}

		.wwd-card__media {
			height: clamp(8rem, 30vh, 14rem);
			order: 1;
		}

		.wwd-scroll-hint {
			display: none;
		}
	}

	@media (max-width: 640px) {
		.what-we-do__header {
			padding: 0.5rem var(--space-4) 0.15rem;
		}

		.what-we-do__title {
			font-size: 1.5rem;
		}

		.what-we-do__subtitle {
			font-size: calc(var(--text-base) * 0.85);
		}
	}
</style>

<script>
	const track = document.querySelector<HTMLElement>("[data-wwd-track]");
	const stage = document.querySelector<HTMLElement>("[data-wwd-stage]");
	const items = document.querySelectorAll<HTMLElement>("[data-wwd-item]");
	const scrollHints = document.querySelectorAll<HTMLElement>("[data-wwd-scroll-hint]");
	const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

	if (track && stage && items.length && !reduceMotion) {
		const count = items.length;
		let activeIndex = -1;
		let ticking = false;

		function setActive(index: number) {
			activeIndex = index;
			items.forEach((item, i) => item.classList.toggle("is-active", i <= activeIndex));
			scrollHints.forEach((hint) => hint.classList.toggle("is-done", activeIndex >= count - 1));
		}

		function update() {
			ticking = false;
			if (!track || !stage) return;

			// The stage pins with `top: var(--nav-height)`, so progress is 0
			// exactly when the track's top reaches the bottom of the sticky
			// nav — the same instant the CSS lock engages. Same reference
			// point drives both, so "where it stops" and "where cards
			// change" can never drift apart.
			const navEl = document.querySelector<HTMLElement>(".sticky-nav");
			const navH = navEl ? navEl.getBoundingClientRect().height : 0;
			const rect = track.getBoundingClientRect();
			const pinnable = track.offsetHeight - stage.offsetHeight;
			const progress = pinnable > 0 ? Math.min(1, Math.max(0, (navH - rect.top) / pinnable)) : rect.top <= navH ? 1 : 0;

			const bucket = Math.min(count - 1, Math.floor(progress * count));
			if (bucket !== activeIndex) setActive(bucket);
		}

		function onScroll() {
			if (ticking) return;
			ticking = true;
			requestAnimationFrame(update);
		}

		window.addEventListener("scroll", onScroll, { passive: true });
		window.addEventListener("resize", onScroll);
		update();
	} else {
		items.forEach((item) => item.classList.add("is-active"));
		scrollHints.forEach((hint) => hint.classList.add("is-done"));
	}
</script>
