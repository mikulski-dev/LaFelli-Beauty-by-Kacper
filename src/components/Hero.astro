---
import { business } from "../lib/business";

// Hero: image carousel (crossfades when there is more than one slide) behind the headline, with a quick
// enquiry form on the right. There is no email/backend for the business, so
// the form opens WhatsApp with the details prefilled (same as the Contact form).
const slides = ["/images/hero/slide-1.jpg"]; // add more paths here and they crossfade automatically
const treatments = [
	"Lymphatic Drainage Massage",
	"Relaxing Massage",
	"Face Massage",
	"Waxing",
	"Nails",
	"Eyebrows",
	"Other",
];
const sources = ["Instagram", "Facebook", "Google", "Friend or family", "Passing by", "Other"];
---

<section class="hero" id="hero" data-slides={slides.length}>
	<div class="hero__slides" aria-hidden="true">
		{slides.map((src, i) => <img class="hero__slide" style={`--i:${i}`} src={src} alt="" loading={i === 0 ? "eager" : "lazy"} decoding="async" />)}
	</div>
	<div class="hero__shade" aria-hidden="true"></div>

	<div class="hero__inner">
		<div class="hero__content">
			<p class="hero__eyebrow">WILLASTON &middot; NANTWICH &middot; CHESHIRE</p>
			<h1 class="hero__title">Beauty and relief, in expert <em>hands</em>.</h1>
			<p class="hero__body">Lymphatic drainage, massage and Brazilian beauty in Willaston.</p>
			<div class="hero__actions">
				<a class="hero__button hero__button--filled" href={business.bookingUrl} target="_blank" rel="noopener noreferrer">Book online</a>
				<a class="hero__button hero__button--outline" href={business.whatsappUrl} target="_blank" rel="noopener noreferrer">Call or WhatsApp</a>
			</div>
			<p class="hero__phone"><a href={business.phoneHref}>{business.phoneDisplay}</a></p>
			<div class="hero__badges">
				<p class="hero__badge"><span aria-hidden="true">&#9670;</span>Qualified massage therapist</p>
				<p class="hero__badge"><span aria-hidden="true">&#9670;</span>Private studio in Willaston</p>
			</div>
		</div>

		<form class="hero-form" data-hero-form novalidate>
			<h2 class="hero-form__title">Start your enquiry</h2>
			<p class="hero-form__sub">Lili personally reads every message.</p>

			<div class="hero-form__row">
				<label class="hero-form__field">
					<span class="hero-form__label">Full name</span>
					<input class="hero-form__input" type="text" name="name" placeholder="Your full name" required autocomplete="name" />
				</label>
				<label class="hero-form__field">
					<span class="hero-form__label">Phone</span>
					<input class="hero-form__input" type="tel" name="phone" placeholder="07xxx xxxxxx" required autocomplete="tel" />
				</label>
			</div>

			<label class="hero-form__field">
				<span class="hero-form__label">Email address</span>
				<input class="hero-form__input" type="email" name="email" placeholder="your@email.com" autocomplete="email" />
			</label>

			<label class="hero-form__field">
				<span class="hero-form__label">Which treatment?</span>
				<select class="hero-form__input" name="treatment" required>
					<option value="">Please select…</option>
					{treatments.map((t) => <option value={t}>{t}</option>)}
				</select>
			</label>

			<label class="hero-form__field">
				<span class="hero-form__label">Anything Lili should know?</span>
				<textarea class="hero-form__input hero-form__input--area" name="message" rows="2" placeholder="Preferred days, questions, anything else…"></textarea>
			</label>

			<label class="hero-form__field">
				<span class="hero-form__label">Where did you find us?</span>
				<select class="hero-form__input" name="source">
					<option value="">Please select…</option>
					{sources.map((s) => <option value={s}>{s}</option>)}
				</select>
			</label>

			<label class="hero-form__consent">
				<input type="checkbox" name="consent" required />
				<span>I agree to be contacted by Lafeli Beauty regarding my enquiry</span>
			</label>

			<button class="hero-form__submit" type="submit">Send enquiry</button>
			<p class="hero-form__status" data-hero-status role="status" aria-live="polite"></p>
		</form>
	</div>
</section>

<style>
	.hero {
		position: relative;
		box-sizing: border-box;
		min-height: calc(100svh - var(--nav-height));
		display: flex;
		align-items: center;
		overflow: hidden;
		background: var(--brown);
		color: #fff;
	}

	/* Crossfade carousel: three slides, 18s cycle. */
	.hero__slides,
	.hero__shade {
		position: absolute;
		inset: 0;
	}
	.hero__slide {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		opacity: 1;
	}
	.hero[data-slides="2"] .hero__slide,
	.hero[data-slides="3"] .hero__slide {
		opacity: 0;
		animation: hero-slide calc(var(--n) * 6s) infinite;
		animation-delay: calc(var(--i) * 6s);
	}
	.hero[data-slides="2"] { --n: 2; }
	.hero[data-slides="3"] { --n: 3; }
	@keyframes hero-slide {
		0% { opacity: 0; }
		8%, 45% { opacity: 1; }
		55%, 100% { opacity: 0; }
	}
	@media (prefers-reduced-motion: reduce) {
		.hero__slide { animation: none; }
		.hero__slide:first-child { opacity: 1; }
	}
	.hero__shade {
		background: linear-gradient(90deg, rgba(74, 46, 38, 0.82) 0%, rgba(74, 46, 38, 0.55) 55%, rgba(74, 46, 38, 0.7) 100%);
	}

	.hero__inner {
		position: relative;
		z-index: 1;
		width: 100%;
		max-width: 1400px;
		margin: 0 auto;
		box-sizing: border-box;
		display: grid;
		grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
		align-items: center;
		gap: clamp(1.5rem, 4vw, 4rem);
		padding: 2.5rem clamp(1.25rem, 4vw, 4rem);
	}

	.hero__content {
		max-width: 38rem;
	}
	.hero__eyebrow {
		font-family: var(--font-body);
		font-weight: 500;
		font-size: calc(var(--text-xs) * 0.9);
		letter-spacing: 0.22em;
		margin: 0 0 1.2rem;
		color: color-mix(in srgb, #fff 85%, transparent);
	}
	.hero__title {
		font-family: var(--font-display);
		font-weight: 300;
		font-size: clamp(2.3rem, 4.6vw, 4.6rem);
		line-height: 1.06;
		max-width: 16ch;
		margin: 0 0 1.2rem;
	}
	.hero__title em {
		font-style: italic;
		color: var(--color-accent);
	}
	.hero__body {
		font-family: var(--font-body);
		font-weight: 300;
		font-size: var(--text-lg);
		color: color-mix(in srgb, #fff 88%, transparent);
		max-width: 30rem;
		margin: 0 0 1.8rem;
	}
	.hero__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
		margin-bottom: 1.2rem;
	}
	.hero__button {
		display: inline-flex;
		align-items: center;
		padding: 0.85rem 1.6rem;
		font-family: var(--font-body);
		font-size: var(--text-xs);
		letter-spacing: 0.06em;
		text-transform: uppercase;
		text-decoration: none;
		white-space: nowrap;
		transition: background 250ms var(--ease-standard), color 250ms var(--ease-standard), border-color 250ms var(--ease-standard);
	}
	.hero__button--filled {
		background: var(--color-accent);
		color: var(--brown);
		border: 1px solid var(--color-accent);
	}
	.hero__button--filled:hover,
	.hero__button--filled:focus-visible {
		background: var(--mauve);
		border-color: var(--mauve);
		color: #fff;
	}
	.hero__button--outline {
		border: 1px solid #fff;
		color: #fff;
	}
	.hero__button--outline:hover,
	.hero__button--outline:focus-visible {
		background: #fff;
		color: var(--brown);
	}
	.hero__phone {
		margin: 0 0 1.6rem;
	}
	.hero__phone a {
		color: #fff;
		text-decoration: underline;
		text-decoration-color: var(--color-accent);
		text-underline-offset: 0.25em;
	}
	.hero__badges {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem 1.8rem;
		padding-top: 1.4rem;
		border-top: 1px solid color-mix(in srgb, #fff 25%, transparent);
	}
	.hero__badge {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		margin: 0;
		font-size: calc(var(--text-xs) * 0.95);
		letter-spacing: 0.05em;
		text-transform: uppercase;
		color: color-mix(in srgb, #fff 80%, transparent);
	}
	.hero__badge span {
		font-size: 0.6rem;
		color: var(--color-accent);
	}

	/* Enquiry card */
	.hero-form {
		box-sizing: border-box;
		width: 100%;
		max-width: 32rem;
		justify-self: end;
		padding: 1.6rem 1.75rem 1.5rem;
		background: rgba(74, 46, 38, 0.92);
		border-top: 3px solid var(--color-accent);
		display: flex;
		flex-direction: column;
		gap: 0.85rem;
	}
	.hero-form__title {
		font-family: var(--font-display);
		font-weight: 400;
		font-style: italic;
		font-size: 1.8rem;
		margin: 0;
	}
	.hero-form__sub {
		margin: -0.5rem 0 0.2rem;
		font-size: var(--text-sm);
		color: color-mix(in srgb, #fff 70%, transparent);
	}
	.hero-form__row {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 0.85rem;
	}
	.hero-form__field {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		min-width: 0;
	}
	.hero-form__label {
		font-size: 0.7rem;
		font-weight: 500;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--color-accent);
	}
	.hero-form__input {
		box-sizing: border-box;
		width: 100%;
		padding: 0.7rem 0.85rem;
		font: inherit;
		font-size: 1rem; /* 16px stops iOS zooming on focus */
		color: #fff;
		background: color-mix(in srgb, #fff 8%, transparent);
		border: 1px solid color-mix(in srgb, #fff 22%, transparent);
		border-radius: 0;
	}
	.hero-form__input::placeholder {
		color: color-mix(in srgb, #fff 45%, transparent);
	}
	.hero-form__input:focus-visible {
		outline: 2px solid var(--color-accent);
		outline-offset: 1px;
	}
	.hero-form__input option {
		color: var(--brown);
	}
	.hero-form__input--area {
		resize: vertical;
		min-height: 3.2rem;
	}
	.hero-form__consent {
		display: flex;
		align-items: flex-start;
		gap: 0.6rem;
		font-size: var(--text-sm);
		color: color-mix(in srgb, #fff 75%, transparent);
	}
	.hero-form__consent input {
		margin-top: 0.2rem;
		accent-color: var(--color-accent);
	}
	.hero-form__submit {
		padding: 0.95rem 1rem;
		font: inherit;
		font-size: var(--text-sm);
		font-weight: 500;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		background: var(--color-accent);
		color: var(--brown);
		border: 0;
		cursor: pointer;
		transition: background 250ms var(--ease-standard), color 250ms var(--ease-standard);
	}
	.hero-form__submit:hover,
	.hero-form__submit:focus-visible {
		background: var(--mauve);
		color: #fff;
	}
	.hero-form__status {
		margin: 0;
		min-height: 1.2em;
		font-size: var(--text-sm);
		color: var(--color-accent);
	}

	@media (max-width: 1024px) {
		.hero__inner {
			grid-template-columns: 1fr;
		}
		.hero__content {
			max-width: none;
			text-align: center;
			display: flex;
			flex-direction: column;
			align-items: center;
		}
		.hero__actions,
		.hero__badges {
			justify-content: center;
		}
		.hero-form {
			justify-self: center;
			max-width: 36rem;
		}
	}
	@media (max-width: 520px) {
		.hero-form__row {
			grid-template-columns: 1fr;
		}
	}
</style>

<script>
	const whatsappNumber = "447769379946";

	document.querySelectorAll<HTMLFormElement>("[data-hero-form]").forEach((form) => {
		const status = form.querySelector<HTMLElement>("[data-hero-status]");

		form.addEventListener("submit", (event) => {
			event.preventDefault();
			const data = new FormData(form);
			const get = (key: string) => String(data.get(key) ?? "").trim();
			const name = get("name");
			const phone = get("phone");

			if (!name || !phone || !get("treatment") || !data.get("consent")) {
				if (status) status.textContent = "Please add your name, phone, a treatment and tick the box.";
				return;
			}

			const text = [
				`Hi Lili, it's ${name}.`,
				`I'm interested in: ${get("treatment")}.`,
				`My phone number: ${phone}.`,
				get("email") && `My email: ${get("email")}.`,
				get("message"),
				get("source") && `I found you via: ${get("source")}.`,
			]
				.filter(Boolean)
				.join(" ");

			window.open(`https://wa.me/${whatsappNumber}?text=${encodeURIComponent(text)}`, "_blank", "noopener,noreferrer");
			if (status) status.textContent = "Opening WhatsApp to send your enquiry…";
		});
	});
</script>
