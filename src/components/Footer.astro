---
// Site footer: three-column layout (logo + book button + socials / contact
// details with icon tiles / quick links), matching the reference footer
// structure, over the graphite brand background.
import logoRose from "../assets/logo/lafeli-logo-rose-on-black.png";

const year = new Date().getFullYear();

const bookingUrl =
	"https://www.fresha.com/en-GB/a/lafeli-beauty-willaston-nantwich-70-colleys-lane-hq1yvezc/booking?menu=true&pId=3085259";
const whatsappUrl = "https://wa.me/447769379946";

const sitePages = [
	{ name: "Home", href: "/" },
	{ name: "Treatments", href: "/pricing" },
	{ name: "About Us", href: "/about" },
	{ name: "Testimonials", href: "/testimonials" },
	{ name: "Contact Us", href: "/contact" },
];

const contactDetails = [
	{ label: "Location", value: "Willaston, Nantwich", sub: "70 Colleys Lane, CW5 6NT" },
	{ label: "Call Us", value: "07769 379946", href: "tel:+447769379946" },
	{ label: "WhatsApp", value: "Message Lili", href: whatsappUrl },
];
---

<footer class="site-footer">
	<div class="site-footer__top">
		<div class="site-footer__col site-footer__col--brand">
			<a class="site-footer__logo" href="/">
				<img class="site-footer__logo-img" src={logoRose.src} width={logoRose.width} height={logoRose.height} alt="Lafeli Beauty" />
			</a>

			<a class="site-footer__quote" href={bookingUrl} target="_blank" rel="noopener noreferrer">Book Now</a>

			<div class="site-footer__socials">
				<a class="site-footer__social" href="https://www.instagram.com/lili_lafeli/" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
						<rect x="3" y="3" width="18" height="18" rx="5" />
						<circle cx="12" cy="12" r="4" />
						<circle cx="17.2" cy="6.8" r="1" fill="currentColor" stroke="none" />
					</svg>
				</a>
				<a class="site-footer__social" href="https://www.facebook.com/p/Lilly-Massage-Therapist-100089978122676/" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
						<path d="M15 8.5h-2c-.8 0-1.5.7-1.5 1.5v2h3.4l-.5 3.2H11.5V21h-3v-5.8H6v-3.2h2.5V9.7C8.5 7 10.2 5 13 5h2v3.5Z" />
					</svg>
				</a>
			</div>
		</div>

		<div class="site-footer__col site-footer__col--contact">
			<p class="site-footer__heading">Contact Us</p>

			<div class="site-footer__contact-list">
				{contactDetails.map((detail) => (
					<div class="site-footer__contact-item">
						<span class="site-footer__contact-icon" aria-hidden="true">
							{detail.label === "Location" && (
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
									<path d="M12 21s7-6.5 7-11.5A7 7 0 0 0 5 9.5C5 14.5 12 21 12 21Z" />
									<circle cx="12" cy="9.5" r="2.5" />
								</svg>
							)}
							{detail.label === "Call Us" && (
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
									<path d="M6.6 10.8c1.4 2.8 3.8 5.2 6.6 6.6l2.2-2.2c.3-.3.7-.4 1.1-.2 1.2.4 2.5.6 3.8.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.9 21 3 13.1 3 4c0-.6.4-1 1-1h3.4c.6 0 1 .4 1 1 0 1.3.2 2.6.6 3.8.1.4 0 .8-.2 1.1L6.6 10.8Z" />
								</svg>
							)}
							{detail.label === "WhatsApp" && (
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
									<path d="M12 3a9 9 0 0 0-7.75 13.5L3 21l4.6-1.2A9 9 0 1 0 12 3Z" />
									<path d="M8.5 9.3c0-.4.3-.7.6-.7h.7c.3 0 .5.2.6.5l.4 1.2c.1.2 0 .5-.1.6l-.5.6c.3.8 1 1.5 1.8 1.8l.6-.5c.2-.1.4-.2.6-.1l1.2.4c.3.1.5.3.5.6v.7c0 .3-.3.6-.7.6-2.9 0-5.7-2.8-5.7-5.7Z" fill="currentColor" stroke="none" />
								</svg>
							)}
						</span>
						<p class="site-footer__contact-label">{detail.label}</p>
						{detail.href ? (
							<a class="site-footer__contact-value site-footer__contact-value--link" href={detail.href} target={detail.href.startsWith("http") ? "_blank" : undefined} rel={detail.href.startsWith("http") ? "noopener noreferrer" : undefined}>
								{detail.value}
							</a>
						) : (
							<p class="site-footer__contact-value">{detail.value}</p>
						)}
						{detail.sub && <p class="site-footer__contact-sub">{detail.sub}</p>}
					</div>
				))}
			</div>
		</div>

		<div class="site-footer__col site-footer__col--links">
			<p class="site-footer__heading">Quick Links</p>
			<nav class="site-footer__nav">
				{sitePages.map((page) => (
					<a class="site-footer__link" href={page.href}>{page.name}</a>
				))}
			</nav>
		</div>
	</div>

	<div class="site-footer__bottom-row">
		<div class="site-footer__bottom">
			<p class="site-footer__copyright">&copy; {year} Lafeli Beauty. All rights reserved.</p>
			<span class="site-footer__bottom-divider" aria-hidden="true">|</span>
			<a class="site-footer__bottom-link" href="/contact">Contact Us</a>
			<span class="site-footer__bottom-divider" aria-hidden="true">|</span>
			<a class="site-footer__bottom-link" href="/privacy">Privacy Policy</a>
		</div>
	</div>
</footer>

<style>
	.site-footer {
		box-sizing: border-box;
		background: var(--color-graphite);
		color: #fff;
		overflow: hidden;
		position: relative;
		z-index: 150;
	}

	.site-footer__top {
		display: grid;
		grid-template-columns: 1fr 1.3fr 1fr;
		gap: calc(var(--space-6) * 1.2);
		max-width: var(--content-width);
		margin: 0 auto;
		padding: calc(var(--section-pad-y) * 1.2) clamp(2.2rem, 5.4vw, 4.6rem) calc(var(--space-6) * 1.2);
	}

	.site-footer__col--brand {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
	}

	.site-footer__col--contact,
	.site-footer__col--links {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
	}

	.site-footer__logo {
		display: block;
		text-decoration: none;
		margin: 0 0 var(--space-4);
	}

	.site-footer__logo-img {
		display: block;
		height: clamp(3.2rem, 5vw, 4.2rem);
		width: auto;
		filter: brightness(0) invert(1);
	}

	.site-footer__quote {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		border: 1px solid color-mix(in srgb, #fff 55%, transparent);
		color: #fff;
		text-decoration: none;
		font-family: var(--font-body);
		font-weight: 500;
		font-size: var(--text-sm);
		letter-spacing: 0.02em;
		padding: 0.75rem 1.6rem;
		margin: 0 0 var(--space-4);
		transition: background 250ms var(--ease-standard), border-color 250ms var(--ease-standard), color 250ms var(--ease-standard);
	}

	.site-footer__quote:hover,
	.site-footer__quote:focus-visible {
		background: var(--color-accent);
		border-color: var(--color-accent);
		color: var(--color-text);
	}

	.site-footer__socials {
		display: flex;
		gap: var(--space-3);
	}

	.site-footer__social {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 2.6rem;
		height: 2.6rem;
		border: 1px solid color-mix(in srgb, #fff 30%, transparent);
		color: #fff;
		transition: border-color 250ms var(--ease-standard), color 250ms var(--ease-standard);
	}

	.site-footer__social svg {
		width: 1.15rem;
		height: 1.15rem;
	}

	.site-footer__social:hover,
	.site-footer__social:focus-visible {
		border-color: var(--color-accent);
		color: var(--color-accent);
	}

	.site-footer__heading {
		font-family: var(--font-display);
		font-weight: 300;
		font-size: clamp(1.4rem, 2vw, 1.75rem);
		letter-spacing: 0.01em;
		color: #fff;
		margin: 0 0 var(--space-5);
	}

	.site-footer__contact-list {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: var(--space-4);
	}

	.site-footer__contact-item {
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	.site-footer__contact-icon {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 2.6rem;
		height: 2.6rem;
		border: 1px solid color-mix(in srgb, #fff 30%, transparent);
		color: #fff;
		margin: 0 0 var(--space-2);
	}

	.site-footer__contact-icon svg {
		width: 1.1rem;
		height: 1.1rem;
	}

	.site-footer__contact-label {
		font-family: var(--font-body);
		font-weight: 500;
		font-size: calc(var(--text-xs) * 0.85);
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: color-mix(in srgb, #fff 65%, transparent);
		margin: 0 0 0.35rem;
	}

	.site-footer__contact-value {
		font-family: var(--font-body);
		font-weight: 400;
		font-size: var(--text-sm);
		color: #fff;
		text-decoration: none;
		margin: 0;
	}

	.site-footer__contact-value--link {
		transition: color 250ms var(--ease-standard);
	}

	.site-footer__contact-value--link:hover,
	.site-footer__contact-value--link:focus-visible {
		color: var(--color-accent);
	}

	.site-footer__contact-sub {
		font-family: var(--font-body);
		font-weight: 300;
		font-size: calc(var(--text-xs) * 1.05);
		color: color-mix(in srgb, #fff 55%, transparent);
		margin: 0.15rem 0 0;
	}

	.site-footer__nav {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: var(--space-3);
	}

	.site-footer__link {
		font-family: var(--font-body);
		font-weight: 400;
		font-size: var(--text-sm);
		color: color-mix(in srgb, #fff 80%, transparent);
		text-decoration: none;
		transition: color 250ms var(--ease-standard);
	}

	.site-footer__link:hover,
	.site-footer__link:focus-visible {
		color: var(--color-accent);
	}

	.site-footer__bottom-row {
		border-top: 1px solid color-mix(in srgb, #fff 15%, transparent);
	}

	.site-footer__bottom {
		max-width: var(--content-width);
		margin: 0 auto;
		padding: var(--space-4) clamp(2.2rem, 5.4vw, 4.6rem);
		display: flex;
		align-items: center;
		justify-content: center;
		flex-wrap: wrap;
		gap: 0.6rem;
	}

	.site-footer__copyright {
		font-family: var(--font-body);
		font-weight: 300;
		font-size: calc(var(--text-xs) * 1.1);
		color: color-mix(in srgb, #fff 55%, transparent);
		margin: 0;
	}

	.site-footer__bottom-divider {
		color: color-mix(in srgb, #fff 30%, transparent);
		font-size: calc(var(--text-xs) * 1.1);
	}

	.site-footer__bottom-link {
		font-family: var(--font-body);
		font-weight: 500;
		font-size: calc(var(--text-xs) * 1.1);
		color: #fff;
		text-decoration: underline;
		text-underline-offset: 0.2em;
		text-decoration-color: color-mix(in srgb, #fff 35%, transparent);
		transition: color 250ms var(--ease-standard);
	}

	.site-footer__bottom-link:hover,
	.site-footer__bottom-link:focus-visible {
		color: var(--color-accent);
	}

	@media (max-width: 1024px) {
		.site-footer {
			display: flex;
			flex-direction: column;
		}

		.site-footer__top {
			grid-template-columns: 1fr;
			gap: var(--space-6);
			padding: var(--space-6) var(--space-4) var(--space-6);
			order: 2;
		}

		.site-footer__col--brand {
			align-items: center;
		}

		.site-footer__bottom-row {
			order: 3;
		}

		.site-footer__bottom {
			padding: var(--space-6) var(--space-4);
		}
	}
</style>
