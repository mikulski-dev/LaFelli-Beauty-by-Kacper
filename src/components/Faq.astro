---
import PencilUnderline from "./PencilUnderline.astro";
import { faqs } from "../lib/faqs";
---

<section class="faq" id="faq">
	<div class="faq__header">
		<p class="faq__eyebrow">
			<span>Questions</span><PencilUnderline color="var(--color-accent)" thickness={2} />
		</p>
		<h2 class="faq__title">Frequently asked questions</h2>
	</div>

	<div class="faq__list">
		{
			faqs.map((f) => (
				<div class="faq__item">
					<button class="faq__trigger" type="button" data-faq-trigger aria-expanded="false">
						<span>{f.q}</span>
						<span class="faq__icon" aria-hidden="true">+</span>
					</button>
					<div class="faq__panel">
						<div class="faq__panel-inner">
							<p>{f.a}</p>
						</div>
					</div>
				</div>
			))
		}
	</div>
</section>

<style>
	.faq {
		box-sizing: border-box;
		background: var(--color-bg-light);
		padding: var(--section-pad-y) var(--space-4);
	}

	.faq__header {
		max-width: 40rem;
		margin: 0 auto var(--space-5);
		text-align: center;
	}

	.faq__eyebrow {
		position: relative;
		display: inline-block;
		width: fit-content;
		font-family: var(--font-body);
		font-weight: 400;
		font-size: calc(var(--text-xs) * 0.85);
		letter-spacing: 0.2em;
		text-transform: uppercase;
		margin: 0 auto 1rem;
	}

	.faq__title {
		font-family: var(--font-display);
		font-weight: 300;
		font-size: clamp(1.8rem, 3vw, var(--text-3xl));
		margin: 0;
	}

	.faq__list {
		max-width: 42rem;
		margin: 0 auto;
	}

	.faq__item {
		border-top: 1px solid var(--color-border);
	}

	.faq__item:last-of-type {
		border-bottom: 1px solid var(--color-border);
	}

	.faq__trigger {
		all: unset;
		box-sizing: border-box;
		display: flex;
		width: 100%;
		align-items: center;
		justify-content: space-between;
		cursor: pointer;
		font-family: var(--font-display);
		font-size: var(--text-lg);
		font-weight: 400;
		color: var(--color-text);
		padding: 0.9rem 0.1rem;
	}

	.faq__icon {
		font-family: var(--font-body);
		font-size: var(--text-lg);
		font-weight: 300;
		color: var(--color-accent);
		transition: transform 300ms var(--ease-standard);
		line-height: 1;
	}

	.faq__trigger[aria-expanded="true"] .faq__icon {
		transform: rotate(45deg);
	}

	.faq__panel {
		height: 0;
		overflow: hidden;
		transition: height 350ms var(--ease-standard);
	}

	@media (prefers-reduced-motion: reduce) {
		.faq__panel {
			transition: none;
		}
	}

	.faq__panel-inner {
		padding: 0 0.1rem 1.1rem;
	}

	.faq__panel-inner p {
		color: var(--color-text-muted);
		font-family: var(--font-body);
		font-weight: 300;
		line-height: var(--leading-normal);
		margin: 0;
	}
</style>

<script>
	document.querySelectorAll<HTMLButtonElement>("[data-faq-trigger]").forEach((trigger) => {
		const panel = trigger.nextElementSibling as HTMLElement | null;
		if (!panel) return;

		trigger.addEventListener("click", () => {
			const isOpen = trigger.getAttribute("aria-expanded") === "true";

			if (isOpen) {
				panel.style.height = `${panel.scrollHeight}px`;
				requestAnimationFrame(() => {
					panel.style.height = "0px";
				});
				trigger.setAttribute("aria-expanded", "false");
			} else {
				panel.style.height = `${panel.scrollHeight}px`;
				trigger.setAttribute("aria-expanded", "true");
				panel.addEventListener(
					"transitionend",
					() => {
						if (trigger.getAttribute("aria-expanded") === "true") panel.style.height = "auto";
					},
					{ once: true },
				);
			}
		});
	});
</script>
