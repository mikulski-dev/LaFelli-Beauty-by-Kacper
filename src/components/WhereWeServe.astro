---
import PencilUnderline from "./PencilUnderline.astro";
import HeroMap from "./HeroMap.astro";
import { business } from "../lib/business";

// "Where to find me" section: a scrolling row of the Cheshire villages and towns
// Lili covers for mobile visits, then the studio address, a short note on the
// mobile service, and the UK dot map pinned to Willaston.
// TODO: Lili to confirm the exact list of areas she covers.
const areas = [
	"Nantwich",
	"Tarporley",
	"Bunbury",
	"Tattenhall",
	"Chester",
	"Alderley Edge",
	"Prestbury",
	"Wilmslow",
	"Knutsford",
	"Holmes Chapel",
	"Sandbach",
	"Congleton",
	"Audlem",
	"Malpas",
	"Farndon",
	"Mobberley",
];
const directionsUrl =
	"https://www.google.com/maps/search/?api=1&query=" + encodeURIComponent(business.address.full);
---

<div class="where-we-serve__divider" aria-hidden="true"></div>

<section class="where-we-serve" id="where-we-serve">
	<div class="where-we-serve__header">
		<p class="where-we-serve__eyebrow">
			<span>Where to find me</span><PencilUnderline color="var(--color-accent)" thickness={2} />
		</p>
		<h2 class="where-we-serve__title">A calm studio, close to home</h2>
	</div>

	<div class="where-we-serve__carousel" data-carousel aria-label="Areas covered by Lafeli Beauty">
		<div class="where-we-serve__carousel-track" data-carousel-track>
			{
				[...areas, ...areas].map((area, i) => (
					<span class="where-we-serve__pill" aria-hidden={i >= areas.length ? "true" : undefined}>
						{area}
					</span>
				))
			}
		</div>
	</div>

	<div class="where-we-serve__body">
		<div class="where-we-serve__info">
			<div class="where-we-serve__block">
				<p class="where-we-serve__label"><span>The studio</span><PencilUnderline color="var(--color-accent)" thickness={2} /></p>
				<p class="where-we-serve__address">{business.address.locality}<br />{business.address.postalCode}</p>
				<p class="where-we-serve__text">
					A calm, private studio in Willaston, just outside Nantwich in Cheshire. Every appointment is one-to-one.
				</p>
			</div>

			<div class="where-we-serve__block">
				<p class="where-we-serve__label"><span>Mobile treatments</span><PencilUnderline color="var(--color-accent)" thickness={2} /></p>
				<p class="where-we-serve__text">
					Can't get to the studio? I also travel to clients at home, across Cheshire and the surrounding villages,
					including the areas above. Message me with your postcode and I'll let you know if I can come to you.
				</p>
			</div>

			<div class="where-we-serve__actions">
				<a class="where-we-serve__button" href="/contact">
					<span class="where-we-serve__button-bg" aria-hidden="true"></span>
					<span class="where-we-serve__button-edge" aria-hidden="true"></span>
					<span class="where-we-serve__button-label" data-label="Get in touch">Get in touch</span>
				</a>
				<a class="where-we-serve__link" href={directionsUrl} target="_blank" rel="noopener noreferrer">Get directions</a>
			</div>
		</div>

		<div class="where-we-serve__map">
			<HeroMap />
		</div>
	</div>
</section>

<script>
	const carousel = document.querySelector<HTMLElement>("[data-carousel]");
	const track = document.querySelector<HTMLElement>("[data-carousel-track]");
	const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

	if (carousel && track && !reduceMotion) {
		let loopWidth = track.scrollWidth / 2;
		const baseSpeed = loopWidth / 42000;
		const hoverSpeed = baseSpeed * 0.12;
		let currentSpeed = baseSpeed;
		let targetSpeed = baseSpeed;
		let position = 0;
		let lastTime: number | null = null;

		carousel.addEventListener("mouseenter", () => {
			targetSpeed = hoverSpeed;
		});
		carousel.addEventListener("mouseleave", () => {
			targetSpeed = baseSpeed;
		});
		window.addEventListener("resize", () => {
			loopWidth = track.scrollWidth / 2;
		});

		function frame(time: number) {
			if (lastTime === null) lastTime = time;
			const dt = time - lastTime;
			lastTime = time;

			currentSpeed += (targetSpeed - currentSpeed) * Math.min(1, dt / 600);
			position -= currentSpeed * dt;
			if (position <= -loopWidth) position += loopWidth;

			track.style.transform = `translateX(${position}px)`;
			requestAnimationFrame(frame);
		}

		requestAnimationFrame(frame);
	}
</script>

<style>
	.where-we-serve__divider {
		height: 1px;
		width: 100%;
		background: linear-gradient(
			to right,
			var(--color-bg-light) 0%,
			color-mix(in srgb, var(--color-graphite) 60%, var(--color-bg-light)) 50%,
			var(--color-bg-light) 100%
		);
	}

	.where-we-serve {
		box-sizing: border-box;
		background: var(--color-bg-light);
		color: var(--color-text);
		padding-bottom: var(--section-pad-y);
	}

	.where-we-serve__header {
		max-width: 40rem;
		margin: 0 auto;
		padding: var(--section-pad-y) var(--space-4) var(--space-5);
		text-align: center;
	}

	.where-we-serve__eyebrow {
		position: relative;
		display: inline-block;
		width: fit-content;
		font-family: var(--font-body);
		font-weight: 400;
		font-size: calc(var(--text-xs) * 0.85);
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: var(--color-text);
		margin: 0 0 var(--space-4);
	}

	.where-we-serve__title {
		font-family: var(--font-display);
		font-weight: 300;
		font-size: clamp(1.9rem, 3.2vw, var(--text-3xl));
		line-height: var(--leading-tight);
		color: var(--color-text);
		margin: 0;
	}

	.where-we-serve__carousel {
		overflow: hidden;
		max-width: 1440px;
		margin: 0 auto;
		mask-image: linear-gradient(to right, transparent 0, #4a2e26 3rem, #4a2e26 calc(100% - 3rem), transparent 100%);
		padding: 0 0 var(--space-5);
	}

	.where-we-serve__carousel-track {
		display: flex;
		width: fit-content;
		gap: var(--space-3);
		will-change: transform;
	}

	.where-we-serve__pill {
		flex-shrink: 0;
		position: relative;
		border-left: 2px solid var(--color-accent);
		padding: 0.6rem 1.25rem;
		font-family: var(--font-body);
		font-size: var(--text-xs);
		font-weight: 400;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: #fff;
		background: var(--color-graphite);
		white-space: nowrap;
		transition: background 250ms var(--ease-standard), border-color 250ms var(--ease-standard);
	}

	.where-we-serve__pill:hover {
		background: var(--color-accent);
		border-left-color: var(--color-graphite);
	}

	@media (prefers-reduced-motion: reduce) {
		.where-we-serve__carousel {
			overflow-x: auto;
		}
	}

	.where-we-serve__body {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		align-items: center;
		gap: clamp(1.5rem, 4vw, 4rem);
		max-width: 1440px;
		margin: 0 auto;
		padding: 0 clamp(2rem, 4.5vw, 4rem);
		box-sizing: border-box;
	}

	.where-we-serve__info {
		display: flex;
		flex-direction: column;
		gap: var(--space-4);
		max-width: 34rem;
	}

	/* Same look as the "Where to find me" eyebrow above. */
	.where-we-serve__label {
		position: relative;
		display: inline-block;
		width: fit-content;
		margin: 0 0 var(--space-3);
		font-family: var(--font-body);
		font-weight: 400;
		font-size: calc(var(--text-xs) * 0.85);
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: var(--color-text);
	}

	.where-we-serve__address {
		margin: 0 0 0.6rem;
		font-family: var(--font-display);
		font-size: clamp(1.4rem, 2.2vw, 1.9rem);
		line-height: 1.25;
	}

	.where-we-serve__text {
		margin: 0;
		font-family: var(--font-body);
		font-weight: 300;
		font-size: calc(var(--text-lg) * 0.85);
		color: var(--color-text-muted);
	}

	.where-we-serve__actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-4);
		margin-top: 0.4rem;
	}

	.where-we-serve__link {
		font-size: var(--text-xs);
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--color-text);
		text-decoration: underline;
		text-decoration-color: var(--mauve);
		text-underline-offset: 0.3em;
	}

	.where-we-serve__link:hover {
		color: var(--mauve);
	}

	/* The UK dot map (HeroMap) needs a wrapper with a height to size itself from. */
	.where-we-serve__map {
		position: relative;
		height: clamp(320px, 60svh, 620px);
	}

	.where-we-serve__button {
		--btn-pad: 0.75rem 1.5rem;
		position: relative;
		display: inline-flex;
		width: fit-content;
		background: var(--color-accent);
		color: var(--color-text);
		text-decoration: none;
		overflow: hidden;
		isolation: isolate;
	}

	.where-we-serve__button-bg {
		position: absolute;
		inset: 0;
		width: 2px;
		background: var(--color-graphite);
		transition: width 350ms var(--ease-standard);
		z-index: 0;
	}

	.where-we-serve__button:hover .where-we-serve__button-bg,
	.where-we-serve__button:focus-visible .where-we-serve__button-bg {
		width: 100%;
	}

	.where-we-serve__button-edge {
		position: absolute;
		left: 0;
		top: 0;
		bottom: 0;
		width: 2px;
		background: var(--color-accent);
		opacity: 0;
		z-index: 1;
		transition: opacity 350ms var(--ease-standard);
	}

	.where-we-serve__button:hover .where-we-serve__button-edge,
	.where-we-serve__button:focus-visible .where-we-serve__button-edge {
		opacity: 1;
	}

	.where-we-serve__button-label {
		position: relative;
		z-index: 1;
		display: inline-flex;
		align-items: center;
		font-size: var(--text-xs);
		font-weight: 400;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		padding: var(--btn-pad);
		white-space: nowrap;
		transition: transform 150ms var(--ease-standard);
	}

	.where-we-serve__button-label::after {
		content: attr(data-label);
		position: absolute;
		inset: 0;
		display: flex;
		align-items: center;
		padding: var(--btn-pad);
		color: #fff;
		clip-path: inset(0 100% 0 0);
		transition: clip-path 350ms var(--ease-standard);
		pointer-events: none;
	}

	.where-we-serve__button:hover .where-we-serve__button-label::after,
	.where-we-serve__button:focus-visible .where-we-serve__button-label::after {
		clip-path: inset(0 0 0 0);
	}

	.where-we-serve__button:active .where-we-serve__button-label {
		transform: scale(0.97);
	}

	@media (max-width: 1024px) {
		.where-we-serve__body {
			grid-template-columns: 1fr;
		}
		.where-we-serve__info {
			max-width: none;
			text-align: center;
			align-items: center;
		}
		.where-we-serve__actions {
			justify-content: center;
		}
		.where-we-serve__map {
			height: 24rem;
		}
		.where-we-serve__map :global(.hero-visual) {
			position: relative;
			inset: auto;
			opacity: 1;
			padding-right: 0;
			justify-content: center;
		}
		.where-we-serve__map :global(.hero-map__pin),
		.where-we-serve__map :global(.hero-map__hq-label) {
			display: block;
		}
	}
</style>
