---
import PencilUnderline from "./PencilUnderline.astro";

// Repurposed from the original "Where We Serve" (multi-area service section,
// which doesn't fit a single home-studio business) into a "Why choose Lafeli
// Beauty" section: a scrolling pill row of reasons to book, plus a map
// pinned to the Willaston studio. Same carousel/map mechanics as before.
const reasons = [
	"Qualified massage therapist",
	"Lymphatic drainage specialist",
	"Home studio in Willaston",
	"Portuguese and English spoken",
	"Book online in a minute",
	"Calm, private space",
];
---

<div class="where-we-serve__divider" aria-hidden="true"></div>

<section class="where-we-serve" id="where-we-serve">
	<div class="where-we-serve__header">
		<p class="where-we-serve__eyebrow">
			<span>Why choose Lafeli Beauty</span><PencilUnderline color="var(--color-accent)" thickness={2} />
		</p>
		<h2 class="where-we-serve__title">A calm studio, close to home</h2>
	</div>

	<div class="where-we-serve__carousel" data-carousel aria-label="Reasons to choose Lafeli Beauty">
		<div class="where-we-serve__carousel-track" data-carousel-track>
			{
				[...reasons, ...reasons].map((reason, i) => (
					<span class="where-we-serve__pill" aria-hidden={i >= reasons.length ? "true" : undefined}>
						{reason}
					</span>
				))
			}
		</div>
	</div>

	<div class="where-we-serve__map-wrap">
		<div class="where-we-serve__map" data-serve-map role="img" aria-label="Map showing the Lafeli Beauty studio in Willaston, Nantwich"></div>
	</div>

	<div class="where-we-serve__cta">
		<a class="where-we-serve__button" href="/contact">
			<span class="where-we-serve__button-bg" aria-hidden="true"></span>
			<span class="where-we-serve__button-edge" aria-hidden="true"></span>
			<span class="where-we-serve__button-label" data-label="Get in touch">Get in touch</span>
		</a>
	</div>
</section>

<script>
	const carousel = document.querySelector<HTMLElement>("[data-carousel]");
	const track = document.querySelector<HTMLElement>("[data-carousel-track]");
	const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

	if (carousel && track && !reduceMotion) {
		let loopWidth = track.scrollWidth / 2;
		const baseSpeed = loopWidth / 42000;
		const hoverSpeed = baseSpeed * 0.12;
		let currentSpeed = baseSpeed;
		let targetSpeed = baseSpeed;
		let position = 0;
		let lastTime: number | null = null;

		carousel.addEventListener("mouseenter", () => {
			targetSpeed = hoverSpeed;
		});
		carousel.addEventListener("mouseleave", () => {
			targetSpeed = baseSpeed;
		});
		window.addEventListener("resize", () => {
			loopWidth = track.scrollWidth / 2;
		});

		function frame(time: number) {
			if (lastTime === null) lastTime = time;
			const dt = time - lastTime;
			lastTime = time;

			currentSpeed += (targetSpeed - currentSpeed) * Math.min(1, dt / 600);
			position -= currentSpeed * dt;
			if (position <= -loopWidth) position += loopWidth;

			track.style.transform = `translateX(${position}px)`;
			requestAnimationFrame(frame);
		}

		requestAnimationFrame(frame);
	}
</script>

<style>
	.where-we-serve__divider {
		height: 1px;
		width: 100%;
		background: linear-gradient(
			to right,
			var(--color-bg-light) 0%,
			color-mix(in srgb, var(--color-graphite) 60%, var(--color-bg-light)) 50%,
			var(--color-bg-light) 100%
		);
	}

	.where-we-serve {
		box-sizing: border-box;
		background: var(--color-bg-light);
		color: var(--color-text);
		padding-bottom: var(--section-pad-y);
	}

	.where-we-serve__header {
		max-width: 40rem;
		margin: 0 auto;
		padding: var(--section-pad-y) var(--space-4) var(--space-5);
		text-align: center;
	}

	.where-we-serve__eyebrow {
		position: relative;
		display: inline-block;
		width: fit-content;
		font-family: var(--font-body);
		font-weight: 400;
		font-size: calc(var(--text-xs) * 0.85);
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: var(--color-text);
		margin: 0 0 var(--space-4);
	}

	.where-we-serve__title {
		font-family: var(--font-display);
		font-weight: 300;
		font-size: clamp(1.9rem, 3.2vw, var(--text-3xl));
		line-height: var(--leading-tight);
		color: var(--color-text);
		margin: 0;
	}

	.where-we-serve__carousel {
		overflow: hidden;
		max-width: 1440px;
		margin: 0 auto;
		mask-image: linear-gradient(to right, transparent 0, #4a2e26 3rem, #4a2e26 calc(100% - 3rem), transparent 100%);
		padding: 0 0 var(--space-5);
	}

	.where-we-serve__carousel-track {
		display: flex;
		width: fit-content;
		gap: var(--space-3);
		will-change: transform;
	}

	.where-we-serve__pill {
		flex-shrink: 0;
		position: relative;
		border-left: 2px solid var(--color-accent);
		padding: 0.6rem 1.25rem;
		font-family: var(--font-body);
		font-size: var(--text-xs);
		font-weight: 400;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: #fff;
		background: var(--color-graphite);
		white-space: nowrap;
		transition: background 250ms var(--ease-standard), border-color 250ms var(--ease-standard);
	}

	.where-we-serve__pill:hover {
		background: var(--color-accent);
		border-left-color: var(--color-graphite);
	}

	@media (prefers-reduced-motion: reduce) {
		.where-we-serve__carousel {
			overflow-x: auto;
		}
	}

	.where-we-serve__map-wrap {
		max-width: 1440px;
		margin: 0 auto var(--space-5);
		padding: 0 clamp(2rem, 4.5vw, 4rem);
		box-sizing: border-box;
	}

	.where-we-serve__map {
		position: relative;
		isolation: isolate;
		width: 100%;
		height: clamp(24rem, 40.8vw, 33.6rem);
	}

	.where-we-serve__cta {
		display: flex;
		justify-content: center;
		max-width: 1440px;
		margin: 0 auto;
		padding: 0 clamp(2rem, 4.5vw, 4rem);
		box-sizing: border-box;
	}

	.where-we-serve__button {
		--btn-pad: 0.75rem 1.5rem;
		position: relative;
		display: inline-flex;
		width: fit-content;
		background: var(--color-accent);
		color: var(--color-text);
		text-decoration: none;
		overflow: hidden;
		isolation: isolate;
	}

	.where-we-serve__button-bg {
		position: absolute;
		inset: 0;
		width: 2px;
		background: var(--color-graphite);
		transition: width 350ms var(--ease-standard);
		z-index: 0;
	}

	.where-we-serve__button:hover .where-we-serve__button-bg,
	.where-we-serve__button:focus-visible .where-we-serve__button-bg {
		width: 100%;
	}

	.where-we-serve__button-edge {
		position: absolute;
		left: 0;
		top: 0;
		bottom: 0;
		width: 2px;
		background: var(--color-accent);
		opacity: 0;
		z-index: 1;
		transition: opacity 350ms var(--ease-standard);
	}

	.where-we-serve__button:hover .where-we-serve__button-edge,
	.where-we-serve__button:focus-visible .where-we-serve__button-edge {
		opacity: 1;
	}

	.where-we-serve__button-label {
		position: relative;
		z-index: 1;
		display: inline-flex;
		align-items: center;
		font-size: var(--text-xs);
		font-weight: 400;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		padding: var(--btn-pad);
		white-space: nowrap;
		transition: transform 150ms var(--ease-standard);
	}

	.where-we-serve__button-label::after {
		content: attr(data-label);
		position: absolute;
		inset: 0;
		display: flex;
		align-items: center;
		padding: var(--btn-pad);
		color: #fff;
		clip-path: inset(0 100% 0 0);
		transition: clip-path 350ms var(--ease-standard);
		pointer-events: none;
	}

	.where-we-serve__button:hover .where-we-serve__button-label::after,
	.where-we-serve__button:focus-visible .where-we-serve__button-label::after {
		clip-path: inset(0 0 0 0);
	}

	.where-we-serve__button:active .where-we-serve__button-label {
		transform: scale(0.97);
	}

	@media (max-width: 1024px) {
		.where-we-serve__map {
			height: 21.6rem;
		}
	}
</style>

<script>
	import L from "leaflet";
	import "leaflet/dist/leaflet.css";

	const mapEl = document.querySelector<HTMLElement>("[data-serve-map]");

	if (mapEl) {
		// Approximate coordinates for Willaston, Nantwich, Cheshire (70 Colleys Lane).
		const studioCoords: [number, number] = [53.0518, -2.5288];

		const map = L.map(mapEl, {
			scrollWheelZoom: false,
			zoomControl: true,
			attributionControl: true,
		}).setView(studioCoords, 13);

		// Standard OpenStreetMap tiles: free, no API key or account needed.
		L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
			attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
			maxZoom: 19,
		}).addTo(map);

		const baseIcon = L.divIcon({
			className: "serve-marker",
			html: '<span class="serve-marker__dot"></span>',
			iconSize: [16, 16],
			iconAnchor: [8, 8],
		});

		L.circle(studioCoords, {
			radius: 700,
			color: "#de9996",
			weight: 1.5,
			fillColor: "#de9996",
			fillOpacity: 0.12,
		}).addTo(map);

		L.marker(studioCoords, { icon: baseIcon })
			.addTo(map)
			.bindPopup("Lafeli Beauty, 70 Colleys Lane, Willaston")
			.openPopup();

		map.on("focus", () => map.scrollWheelZoom.enable());
		map.on("blur", () => map.scrollWheelZoom.disable());
	}
</script>

<style is:global>
	.serve-marker {
		background: transparent;
		border: none;
	}

	.serve-marker__dot {
		display: block;
		width: 14px;
		height: 14px;
		border-radius: 50%;
		background: #de9996;
		border: 2px solid #fff;
	}

	.where-we-serve__map .leaflet-tile-pane {
		filter: grayscale(0.85) brightness(1.08) contrast(0.95) sepia(0.06);
	}

	.where-we-serve__map .leaflet-container {
		outline: none;
		background: var(--color-bg-light);
		font-family: var(--font-body);
	}

	.where-we-serve__map .leaflet-pane,
	.where-we-serve__map .leaflet-top,
	.where-we-serve__map .leaflet-bottom {
		z-index: 10;
	}

	.leaflet-control-attribution {
		font-size: 0.65rem;
	}

	.leaflet-popup-content-wrapper {
		border-radius: 4px;
		box-shadow: 0 12px 32px -14px rgba(74, 46, 38, 0.35);
	}

	.leaflet-popup-content {
		font-family: var(--font-body);
		font-size: 0.8rem;
		letter-spacing: 0.02em;
		color: var(--color-text);
		margin: 10px 14px;
	}

	.leaflet-popup-tip {
		box-shadow: none;
	}
</style>
