---
import PencilUnderline from "./PencilUnderline.astro";
---

<section class="intro" id="about" style="--accent: var(--color-accent)">
	<div class="intro__inner">
		<div class="intro__copy">
			<p class="intro__eyebrow">
				<span>ABOUT LAFELI BEAUTY</span><PencilUnderline color="var(--accent)" thickness={2} />
			</p>
			<h2 class="intro__title">Hello, I'm Lili, and I founded Lafeli Beauty</h2>
			<p class="intro__body">
				I specialise in lymphatic drainage, therapeutic massage, precise waxing and Brazilian
				manicures. I'm a qualified massage therapist, and I treat every client with care and
				skill.
			</p>
			<p class="intro__body intro__body--secondary">
				My aim is simple. I want you to leave feeling lighter, more confident and properly
				looked after.
			</p>
			<blockquote class="intro__quote">
				&ldquo;Lightness. Shape. Presence. That's what I bring to every session.&rdquo;
			</blockquote>
			<a class="intro__button intro__button--dark" href="/pricing">
				<span class="intro__button-bg" aria-hidden="true"></span>
				<span class="intro__button-edge" aria-hidden="true"></span>
				<span class="intro__button-label" data-label="View treatments">View treatments</span>
			</a>
		</div>

		<div class="intro__media">
			<div class="intro__photo">
				<img
					class="intro__photo-img"
					src="/images/portrait/lily.jpg"
					alt="Portrait of Lili, founder of Lafeli Beauty, smiling in her Willaston studio"
					width="1300"
					height="1733"
					loading="lazy"
				/>
			</div>
		</div>
	</div>
</section>

<style>
	.intro {
		--btn-pad: 0.75rem 1.5rem;
		position: relative;
		min-height: 100svh;
		background: var(--color-bg-light);
		color: var(--color-text);
	}

	.intro__inner {
		display: grid;
		grid-template-columns: 1fr 1fr;
		align-items: stretch;
		min-height: 100svh;
		max-width: 1440px;
		margin: 0 auto;
	}

	.intro__media {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: clamp(24px, 3vw, 40px) clamp(24px, 4vw, 64px) clamp(24px, 3vw, 40px) clamp(8px, 1.2vw, 16px);
		box-sizing: border-box;
		background: var(--color-bg-light);
	}

	/* Same tight crop of Lili's portrait as the About page, so the logo watermark is cropped out. */
	.intro__photo {
		position: relative;
		width: 100%;
		max-width: 26rem;
		aspect-ratio: 3 / 4;
		overflow: hidden;
		border-radius: 8px;
		box-shadow: 0 12px 32px -14px rgba(74, 46, 38, 0.25);
	}

	.intro__photo-img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 50% 24%;
		transform-origin: 50% 24%;
		scale: 1.9;
	}

	.intro__copy {
		display: flex;
		flex-direction: column;
		justify-content: center;
		padding: var(--section-pad-y) clamp(0.75rem, 1.5vw, 1.25rem) var(--section-pad-y) clamp(2rem, 6vw, 6rem);
	}

	.intro__eyebrow {
		position: relative;
		display: inline-block;
		width: fit-content;
		font-family: var(--font-body);
		font-weight: 400;
		font-size: calc(var(--text-xs) * 0.85);
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: var(--color-text);
		margin-bottom: 1.6rem;
	}

	.intro__eyebrow:hover :global(.pencil-underline) {
		background: currentColor;
	}

	.intro__title {
		font-family: var(--font-display);
		font-weight: 300;
		font-size: clamp(1.9rem, 3.2vw, var(--text-3xl));
		line-height: 1.15;
		margin: 0 0 1.6rem;
		max-width: 22ch;
	}

	.intro__body {
		font-family: var(--font-body);
		font-weight: 300;
		font-size: calc(var(--text-lg) * 0.85);
		color: var(--color-text-muted);
		max-width: 38rem;
		margin: 0 0 1.2rem;
	}

	.intro__quote {
		font-family: var(--font-display);
		font-style: italic;
		font-weight: 400;
		font-size: clamp(1.2rem, 1.8vw, 1.5rem);
		color: var(--color-text);
		border-left: 2px solid var(--accent);
		padding-left: 1.2rem;
		margin: 0.8rem 0 1.8rem;
		max-width: 30rem;
	}

	.intro__button {
		--btn-pad: 0.75rem 1.5rem;
		position: relative;
		display: inline-flex;
		width: fit-content;
		margin-top: 0.8rem;
		background: #fff;
		color: var(--brown);
		text-decoration: none;
		overflow: hidden;
		isolation: isolate;
	}

	.intro__button-bg {
		position: absolute;
		inset: 0;
		width: 2px;
		background: var(--accent);
		transition: width 350ms var(--ease-standard);
		z-index: 0;
	}

	.intro__button:hover .intro__button-bg,
	.intro__button:focus-visible .intro__button-bg {
		width: 100%;
	}

	.intro__button:active .intro__button-bg {
		background: color-mix(in srgb, var(--accent) 80%, var(--brown));
	}

	.intro__button-edge {
		position: absolute;
		left: 0;
		top: 0;
		bottom: 0;
		width: 2px;
		background: #fff;
		opacity: 0;
		z-index: 1;
		transition: opacity 350ms var(--ease-standard);
	}

	.intro__button:hover .intro__button-edge,
	.intro__button:focus-visible .intro__button-edge {
		opacity: 1;
	}

	.intro__button-label {
		position: relative;
		z-index: 1;
		display: inline-flex;
		align-items: center;
		font-size: var(--text-xs);
		font-weight: 400;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		padding: var(--btn-pad);
		white-space: nowrap;
		transition: transform 150ms var(--ease-standard);
	}

	.intro__button-label::after {
		content: attr(data-label);
		position: absolute;
		inset: 0;
		display: flex;
		align-items: center;
		padding: var(--btn-pad);
		color: #fff;
		clip-path: inset(0 100% 0 0);
		transition: clip-path 350ms var(--ease-standard);
		pointer-events: none;
	}

	.intro__button:hover .intro__button-label::after,
	.intro__button:focus-visible .intro__button-label::after {
		clip-path: inset(0 0 0 0);
	}

	.intro__button:active .intro__button-label {
		transform: scale(0.97);
	}

	/* Dark variant: brown fill, white text, rose accent edge on the left. */
	.intro__button--dark {
		background: var(--color-graphite);
		color: #fff;
	}

	.intro__button--dark .intro__button-bg {
		background: var(--accent);
	}

	.intro__button--dark:active .intro__button-bg {
		background: color-mix(in srgb, var(--accent) 80%, var(--brown));
	}

	.intro__button--dark .intro__button-edge {
		background: var(--color-graphite);
		opacity: 0;
	}

	.intro__button--dark:hover .intro__button-edge,
	.intro__button--dark:focus-visible .intro__button-edge {
		opacity: 1;
	}

	@media (max-width: 1024px) {
		.intro {
			min-height: auto;
		}

		.intro__inner {
			grid-template-columns: 1fr;
			min-height: auto;
		}

		.intro__media {
			padding: 20px;
		}


		.intro__copy {
			padding: var(--space-6) var(--space-4);
		}
	}

	@media (max-width: 640px) {
		.intro__inner {
			display: flex;
			flex-direction: column;
		}

		.intro__copy {
			order: 1;
			align-items: center;
			text-align: center;
			padding: var(--space-3) var(--space-4) var(--space-4);
		}

		.intro__media {
			order: 2;
			position: relative;
			height: auto;
			padding: var(--space-5) var(--space-4) var(--space-3);
			display: flex;
		}

		.intro__eyebrow {
			font-size: calc(var(--text-xs) * 0.7);
			margin-bottom: 1rem;
			margin-left: auto;
			margin-right: auto;
		}

		.intro__title {
			font-size: 1.5rem;
			line-height: 1.15;
			margin-bottom: 1rem;
			max-width: 22ch;
		}

		.intro__body {
			font-size: calc(var(--text-lg) * 0.6);
			line-height: 1.45;
			max-width: 32rem;
		}

		.intro__quote {
			margin-left: auto;
			margin-right: auto;
			text-align: left;
		}

		.intro__button {
			margin-top: 0.4rem;
			margin-left: auto;
			margin-right: auto;
		}
	}
</style>

<script>
	const media = document.querySelector<HTMLElement>("[data-collage]");
	const parallaxEls = Array.from(document.querySelectorAll<HTMLElement>("[data-parallax]"));

	if (
		media &&
		parallaxEls.length &&
		!window.matchMedia("(prefers-reduced-motion: reduce)").matches &&
		!window.matchMedia("(max-width: 640px)").matches
	) {
		const ranges: Record<string, number> = { up: 90, down: 130, side: 100 };

		let ticking = false;
		function update() {
			ticking = false;
			const rect = media!.getBoundingClientRect();
			const viewportH = window.innerHeight;
			const progress = Math.max(
				-1,
				Math.min(1, (viewportH / 2 - (rect.top + rect.height / 2)) / (viewportH / 2 + rect.height / 2))
			);

			for (const el of parallaxEls) {
				const speed = parseFloat(el.dataset.speed ?? "1");
				const dir = el.dataset.dir ?? "up";
				const range = ranges[dir] ?? 100;
				const offset = progress * range * speed;

				if (dir === "side") {
					el.style.setProperty("--dx", `${offset}px`);
					el.style.setProperty("--dy", "0px");
				} else {
					const sign = dir === "down" ? -1 : 1;
					el.style.setProperty("--dy", `${offset * sign}px`);
					el.style.setProperty("--dx", "0px");
				}
			}
		}

		function onScroll() {
			if (ticking) return;
			ticking = true;
			requestAnimationFrame(update);
		}

		window.addEventListener("scroll", onScroll, { passive: true });
		window.addEventListener("resize", onScroll);
		update();
	}
</script>
