---
import PencilUnderline from "./PencilUnderline.astro";
import Button from "./Button.astro";
import { business } from "../lib/business";
---

<div class="testimonials__divider" aria-hidden="true"></div>

<section class="testimonials" id="testimonials" style="--accent: var(--color-accent)">
	<div class="testimonials__header">
		<p class="testimonials__eyebrow">
			<span>Testimonials</span><PencilUnderline color="var(--accent)" thickness={2} />
		</p>
		<h2 class="testimonials__title">What clients say</h2>
	</div>

	<div class="testimonials__panel">
		<p class="testimonials__lead">Read what Lili's clients say on Fresha</p>
		<Button href={business.bookingUrl} label="Read reviews on Fresha" variant="outline-light" external />
	</div>
</section>

<style>
	.testimonials__divider {
		height: 1px;
		width: 100%;
		background: linear-gradient(
			to right,
			var(--color-bg) 0%,
			color-mix(in srgb, var(--color-graphite) 60%, var(--color-bg)) 50%,
			var(--color-bg) 100%
		);
	}

	.testimonials {
		box-sizing: border-box;
		background: var(--color-bg-light);
		color: var(--color-text);
		padding-bottom: var(--section-pad-y);
	}

	.testimonials__header {
		max-width: 40rem;
		margin: 0 auto;
		padding: var(--section-pad-y) clamp(2rem, 4.5vw, 4rem) var(--space-6);
		text-align: center;
	}

	.testimonials__eyebrow {
		position: relative;
		display: inline-block;
		width: fit-content;
		font-family: var(--font-body);
		font-weight: 400;
		font-size: calc(var(--text-xs) * 0.85);
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: var(--color-text);
		margin: 0 0 var(--space-4);
	}

	.testimonials__title {
		font-family: var(--font-display);
		font-weight: 300;
		font-size: clamp(1.9rem, 3.2vw, var(--text-3xl));
		line-height: var(--leading-tight);
		color: var(--color-text);
		margin: 0 0 var(--space-3);
	}

	.testimonials__subtitle {
		font-family: var(--font-body);
		font-weight: 300;
		font-size: calc(var(--text-lg) * 0.85);
		color: var(--color-text-muted);
		line-height: var(--leading-normal);
		margin: 0;
	}

	.testimonials__panel {
		position: relative;
		max-width: var(--content-width);
				margin: 0 auto;
		padding: clamp(3.5rem, 6vw, 5rem) clamp(2rem, 4.5vw, 5rem);
		background: var(--color-graphite);
		box-sizing: border-box;
		overflow: hidden;
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		text-align: center;
		gap: var(--space-5);
	}

	.testimonials__lead {
		font-family: var(--font-display);
		font-weight: 300;
		font-size: clamp(1.3rem, 2.4vw, var(--text-2xl));
		line-height: var(--leading-tight);
		color: #fff;
		margin: 0;
		max-width: 42rem;
	}

	@media (max-width: 1024px) {
		.testimonials__header {
			padding: var(--space-6) var(--space-4) var(--space-5);
		}

		.testimonials__panel {
			max-width: none;
			margin: 0 var(--space-4);
			padding: 2.5rem var(--space-4);
		}

		.testimonials__lead {
			font-size: clamp(1.15rem, 4.6vw, 1.4rem);
		}
	}
</style>
