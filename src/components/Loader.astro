---
import logoRose from "../assets/logo/lafeli-logo-rose-on-black.png";

// Intro loader: black screen, the logo pops in, then the screen fades straight
// to the site. Plays once per browser session, and never with reduced motion.
// Pure CSS, so it cannot get stuck if scripts fail.
---

<div class="loader" aria-hidden="true">
	<img class="loader__logo" src={logoRose.src} width={logoRose.width} height={logoRose.height} alt="" />
</div>

<style is:global>
	.loader {
		position: fixed;
		inset: 0;
		z-index: 10000;
		display: flex;
		align-items: center;
		justify-content: center;
		background: #000;
		animation: loader-out 450ms var(--ease-standard) 1350ms forwards;
	}
	.loader__logo {
		width: min(15rem, 55vw);
		height: auto;
		filter: none;
		opacity: 0;
		transform: scale(0.85);
		animation: loader-pop 700ms cubic-bezier(0.34, 1.4, 0.64, 1) 200ms forwards;
	}
	@keyframes loader-pop {
		to {
			opacity: 1;
			transform: scale(1);
		}
	}
	@keyframes loader-out {
		to {
			opacity: 0;
			visibility: hidden;
		}
	}
	.loader-seen .loader {
		display: none;
	}
	@media (prefers-reduced-motion: reduce) {
		.loader {
			display: none;
		}
	}
</style>
