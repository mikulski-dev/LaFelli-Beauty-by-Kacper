---
import PencilUnderline from "./PencilUnderline.astro";

// Shared page hero: eyebrow + H1 + one intro line, staggered fade-up.
// Same look as the pricing page hero. Optional slot sits under the intro.
interface Props {
	eyebrow?: string;
	title: string;
	intro: string;
}
const { eyebrow, title, intro } = Astro.props;
---

<section class="page-hero grid-texture">
	<div class="page-hero__inner">
		{
			eyebrow && (
				<p class="page-hero__eyebrow reveal-up" style="--d:0ms">
					<span>{eyebrow}</span><PencilUnderline color="var(--color-accent)" thickness={2} />
				</p>
			)
		}
		<h1 class="page-hero__title reveal-up" style="--d:80ms">{title}</h1>
		<p class="page-hero__body reveal-up" style="--d:160ms">{intro}</p>
		<div class="page-hero__extra reveal-up" style="--d:240ms"><slot /></div>
	</div>
</section>

<style>
	.page-hero {
		position: relative;
		background: var(--color-bg-light);
		color: var(--color-text);
		padding: calc(var(--section-pad-y) * 1.3) var(--space-4) calc(var(--section-pad-y) * 0.9);
	}
	.page-hero__inner {
		position: relative;
		z-index: 1;
		max-width: 46rem;
		margin: 0 auto;
		text-align: center;
	}
	.page-hero__eyebrow {
		position: relative;
		display: inline-block;
		width: fit-content;
		font-family: var(--font-body);
		font-weight: 500;
		font-size: calc(var(--text-xs) * 0.9);
		letter-spacing: 0.22em;
		text-transform: uppercase;
		margin-bottom: 1.4rem;
	}
	.page-hero__title {
		font-family: var(--font-display);
		font-weight: 300;
		font-size: clamp(2rem, 4.2vw, 3.6rem);
		line-height: 1.1;
		margin-bottom: 1.2rem;
	}
	.page-hero__body {
		font-family: var(--font-body);
		font-weight: 300;
		font-size: calc(var(--text-lg) * 0.9);
		color: var(--color-text-muted);
		max-width: 34rem;
		margin: 0 auto;
	}
	.page-hero__extra {
		margin-top: 1.8rem;
	}
	.page-hero__extra:empty {
		display: none;
	}
</style>
